{"version":2,"custom":{"origInclude":true,"origExclude":true,"origMatch":true,"origExcludeMatch":true,"origTag":true,"lastInstallURL":"https://update.greasyfork.org/scripts/594194/Command%20Code%20Usage%20%E7%BB%9F%E8%AE%A1%E9%9D%A2%E6%9D%BF.user.js","pathMap":{}},"config":{"enabled":1,"removed":0,"shouldUpdate":1},"props":{"lastUpdated":1790473184658},"code":"// ==UserScript==\n// @name         Command Code Usage 统计面板\n// @namespace    https://github.com/local\n// @version      1.0.1\n// @description  在 usage 页面注入统计面板：增量同步数据到 GM 存储，展示趋势图/模型占比/每日费用表\n// @match        https://commandcode.ai/*/settings/usage*\n// @grant        GM_setValue\n// @grant        GM_getValue\n// @grant        GM_deleteValue\n// @grant        GM_addStyle\n// @run-at       document-idle\n// @license MIT\n// @downloadURL https://update.greasyfork.org/scripts/594194/Command%20Code%20Usage%20%E7%BB%9F%E8%AE%A1%E9%9D%A2%E6%9D%BF.user.js\n// @updateURL https://update.greasyfork.org/scripts/594194/Command%20Code%20Usage%20%E7%BB%9F%E8%AE%A1%E9%9D%A2%E6%9D%BF.meta.js\n// ==/UserScript==\n\n(function () {\n  'use strict';\n\n  // ---------- 常量 ----------\n  const API = 'https://api.commandcode.ai/internal';\n  const STORE_KEY = 'cc_usage_records';\n  const SYNC_FLAG = 'cc_usage_synced_at';\n  const DELAY_MS = 1200; // 翻页限速\n\n  // ---------- GM 存储 ----------\n  const loadRecords = () => { try { return GM_getValue(STORE_KEY, []); } catch { return []; } };\n  const saveRecords = (records) => GM_setValue(STORE_KEY, records);\n\n  // ---------- 工具 ----------\n  const sleep = ms => new Promise(r => setTimeout(r, ms));\n  const fmtInt = n => Math.round(n).toLocaleString('en-US');\n  const fmtCost = n => '$' + (n ?? 0).toFixed(4);\n  const fmtCost2 = n => '$' + (n ?? 0).toFixed(2);\n  const fmtDur = ms => ms >= 60000 ? (ms / 60000).toFixed(1) + 'm' : (ms / 1000).toFixed(1) + 's';\n\n  function normalize(u) {\n    return {\n      id: u.id,\n      createdAt: u.createdAt,\n      tokensIn: Number(u.tokensIn) || 0,\n      tokensOut: Number(u.tokensOut) || 0,\n      durationTotal: Number(u.durationTotal) || 0,\n      status: u.status,\n      mode: u.mode || u.type,\n      model: u.meta?.model || 'unknown',\n      totalCost: u.meta?.totalCost ?? 0,\n      traceId: u.meta?.traceId || '',\n    };\n  }\n\n  // ---------- API ----------\n  async function fetchUsagePage(cursor) {\n    const url = new URL(API + '/usage');\n    url.searchParams.set('limit', '100');\n    if (cursor) url.searchParams.set('cursor', cursor);\n    const res = await fetch(url, { credentials: 'include', headers: { accept: 'application/json' } });\n    if (!res.ok) throw new Error('usage API HTTP ' + res.status);\n    return res.json();\n  }\n\n  /**\n   * 增量同步：从最新往回翻，直到命中已存记录的 id。\n   * @returns {{added: number, pages: number}}\n   */\n  async function syncIncremental(onProgress) {\n    const stored = loadRecords();\n    const ids = new Set(stored.map(r => r.id));\n    const fetched = [];\n    let cursor = null, pages = 0, hit = false;\n\n    while (pages < 500) { // 安全上限\n      const data = await fetchUsagePage(cursor);\n      pages++;\n      for (const u of (data.usages || [])) {\n        if (ids.has(u.id)) { hit = true; break; }\n        fetched.push(normalize(u));\n      }\n      if (hit || !data.nextCursor) break;\n      cursor = data.nextCursor;\n      onProgress?.(`同步中: 第 ${pages} 页, 新增 ${fetched.length} 条...`);\n      await sleep(DELAY_MS);\n    }\n\n    if (fetched.length) {\n      const merged = dedupeMerge(stored, fetched);\n      saveRecords(merged);\n      GM_setValue(SYNC_FLAG, Date.now());\n    }\n    return { added: fetched.length, pages };\n  }\n\n  function dedupeMerge(existing, incoming) {\n    const byId = new Map();\n    for (const r of existing) byId.set(r.id, r);\n    for (const r of incoming) byId.set(r.id, r);\n    return [...byId.values()].sort((a, b) => b.createdAt.localeCompare(a.createdAt));\n  }\n\n  // ---------- 注入 UI ----------\n  GM_addStyle(`\n    #cc-usage-panel { position: fixed; bottom: 16px; right: 16px; width: 780px; max-width: 96vw;\n      background: #16181f; border: 1px solid #2a2e3d; border-radius: 12px; z-index: 99999;\n      box-shadow: 0 8px 32px rgba(0,0,0,.5); color: #e2e5ee; font: 13px/1.5 -apple-system,\"Segoe UI\",\"Microsoft YaHei\",sans-serif; resize: both; overflow: hidden; display: flex; flex-direction: column; }\n    #cc-usage-panel .head { display: flex; align-items: center; justify-content: space-between;\n      padding: 10px 14px; border-bottom: 1px solid #2a2e3d; user-select: none; cursor: move; flex-shrink: 0; }\n    #cc-usage-panel .head b { font-size: 13px; cursor: pointer; }\n    #cc-usage-panel .head .st { color: #8b90a3; font-size: 12px; margin-left: 8px; }\n    #cc-usage-panel .head .ctl { display: flex; gap: 6px; align-items: center; }\n    #cc-usage-panel .head button { background: none; border: 1px solid #2a2e3d; border-radius: 4px;\n      color: #8b90a3; width: 22px; height: 22px; cursor: pointer; font-size: 12px; line-height: 1; padding: 0; }\n    #cc-usage-panel .head button:hover { color: #6c8cff; border-color: #6c8cff; }\n    #cc-usage-panel .body { display: none; padding: 14px; overflow: auto; flex: 1; }\n    #cc-usage-panel.open .body { display: block; }\n    #cc-usage-panel .btns { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }\n    #cc-usage-panel button { background: #1e2230; color: #e2e5ee; border: 1px solid #2a2e3d;\n      border-radius: 6px; padding: 5px 12px; font-size: 12px; cursor: pointer; }\n    #cc-usage-panel button:hover { border-color: #6c8cff; color: #6c8cff; }\n    #cc-usage-panel button:disabled { opacity: .5; cursor: not-allowed; }\n    #cc-usage-panel .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 12px; }\n    #cc-usage-panel .card { background: #1a1d27; border: 1px solid #2a2e3d; border-radius: 8px; padding: 8px 10px; }\n    #cc-usage-panel .card .l { color: #8b90a3; font-size: 11px; }\n    #cc-usage-panel .card .v { font-size: 16px; font-weight: 600; }\n    #cc-usage-panel .charts { display: grid; grid-template-columns: 1fr; gap: 10px; margin-bottom: 12px; }\n    #cc-usage-panel .charts.pies { grid-template-columns: 1fr 1fr; }\n    #cc-usage-panel .cbox { background: #1a1d27; border: 1px solid #2a2e3d; border-radius: 8px; padding: 8px; }\n    #cc-usage-panel .chart { width: 100%; height: 260px; }\n    #cc-usage-panel .daily { background: #1a1d27; border: 1px solid #2a2e3d; border-radius: 8px; overflow: auto; max-height: 300px; }\n    #cc-usage-panel table { width: 100%; border-collapse: collapse; font-size: 12px; }\n    #cc-usage-panel th, #cc-usage-panel td { padding: 6px 10px; text-align: right; border-bottom: 1px solid #23273540; white-space: nowrap; font-variant-numeric: tabular-nums; }\n    #cc-usage-panel th:first-child, #cc-usage-panel td:first-child { text-align: left; }\n    #cc-usage-panel th { position: sticky; top: 0; background: #1a1d27; color: #8b90a3; font-weight: 500; }\n    #cc-usage-panel .rng { display: flex; gap: 6px; align-items: center; margin-bottom: 12px; color: #8b90a3; font-size: 12px; }\n    #cc-usage-panel .rng b { color: #e2e5ee; }\n    #cc-usage-panel .bar-bg { height: 6px; background: #2a2e3d; border-radius: 3px; margin-top: 8px; overflow: hidden; }\n    #cc-usage-panel .bar-fill { height: 100%; border-radius: 3px; background: #6c8cff; transition: width .4s; }\n    #cc-usage-panel .bar-fill.warn { background: #fbbf24; } #cc-usage-panel .bar-fill.danger { background: #f87171; }\n    #cc-usage-panel #ccu-limits { display: flex; flex-direction: column; gap: 6px; background: #1a1d27; border: 1px solid #2a2e3d; border-radius: 8px; padding: 10px 12px; }\n    #cc-usage-panel .limit-row { display: flex; align-items: center; gap: 10px; }\n    #cc-usage-panel .limit-row .lname { width: 60px; color: #8b90a3; font-size: 12px; flex-shrink: 0; }\n    #cc-usage-panel .limit-row .bar-bg { flex: 1; margin-top: 0; }\n    #cc-usage-panel .limit-row .lval { color: #8b90a3; font-size: 12px; font-variant-numeric: tabular-nums; flex-shrink: 0; }\n    #cc-usage-panel .limit-row .lpct { width: 48px; text-align: right; font-weight: 600; font-size: 12px; flex-shrink: 0; }\n    #cc-usage-panel .limit-row .lpct.warn { color: #fbbf24; } #cc-usage-panel .limit-row .lpct.danger { color: #f87171; }\n  `);\n\n  const panel = document.createElement('div');\n  panel.id = 'cc-usage-panel';\n  panel.innerHTML = `\n    <div class=\"head\" id=\"ccu-head\"><span><b>CC Usage 统计</b><span class=\"st\" id=\"ccu-status\"></span></span><span class=\"ctl\"><button id=\"ccu-toggle\" title=\"折叠/展开\">–</button></span></div>\n    <div class=\"body\">\n      <div class=\"rng\">\n        范围:\n        <button data-r=\"1\">今天</button><button data-r=\"7\" class=\"active\">7天</button><button data-r=\"30\">30天</button><button data-r=\"0\">全部</button>\n        <span>数据: <b id=\"ccu-count\">0</b> 条</span>\n      </div>\n      <div class=\"btns\">\n        <button id=\"ccu-sync\">同步增量</button>\n        <button id=\"ccu-export\">导出 JSON</button>\n        <button id=\"ccu-clear\">清空数据</button>\n        <span class=\"st\" id=\"ccu-last\"></span>\n      </div>\n      <div class=\"cards\" id=\"ccu-cards\"></div>\n      <div id=\"ccu-limits\" style=\"margin-bottom:12px\"></div>\n      <div class=\"charts\">\n        <div class=\"cbox\"><div id=\"ccu-trend\" class=\"chart\"></div></div>\n      </div>\n      <div class=\"charts pies\">\n        <div class=\"cbox\"><div id=\"ccu-model\" class=\"chart\"></div></div>\n        <div class=\"cbox\"><div id=\"ccu-cost\" class=\"chart\"></div></div>\n      </div>\n      <div class=\"daily\"><table id=\"ccu-daily\"></table></div>\n    </div>`;\n  document.body.appendChild(panel);\n\n  const $ = s => panel.querySelector(s);\n  const statusEl = $('#ccu-status');\n  const setStatus = (t, busy) => { statusEl.textContent = t; $('#ccu-sync').disabled = !!busy; };\n\n  // 上次同步时间显示\n  function renderLastSync() {\n    const last = GM_getValue(SYNC_FLAG, 0);\n    const el = $('#ccu-last');\n    if (!last) { el.textContent = ''; return; }\n    const mins = Math.floor((Date.now() - last) / 6e4);\n    el.textContent = '上次同步: ' + (mins < 1 ? '刚刚' : mins < 60 ? mins + ' 分钟前' : Math.floor(mins / 60) + ' 小时前');\n    el.style.color = mins > 1440 ? '#f87171' : mins > 300 ? '#fbbf24' : '#8b90a3';\n  }\n\n  // 折叠（按钮触发，不与拖动冲突）\n  $('#ccu-toggle').onclick = (e) => {\n    e.stopPropagation();\n    panel.classList.toggle('open');\n    $('#ccu-toggle').textContent = panel.classList.contains('open') ? '–' : '+';\n    if (panel.classList.contains('open')) renderAll();\n  };\n  panel.classList.add('open'); // 默认展开\n\n  // 拖动（按标题栏拖动）\n  const head = $('#ccu-head');\n  head.addEventListener('mousedown', (e) => {\n    if (e.target.closest('button')) return; // 按钮不触发拖动\n    const rect = panel.getBoundingClientRect();\n    const dx = e.clientX - rect.left, dy = e.clientY - rect.top;\n    panel.style.right = 'auto'; panel.style.bottom = 'auto';\n    panel.style.left = rect.left + 'px'; panel.style.top = rect.top + 'px';\n    const move = (ev) => {\n      const x = Math.min(window.innerWidth - 60, Math.max(-rect.width + 60, ev.clientX - dx));\n      const y = Math.min(window.innerHeight - 40, Math.max(0, ev.clientY - dy));\n      panel.style.left = x + 'px'; panel.style.top = y + 'px';\n    };\n    const up = () => { document.removeEventListener('mousemove', move); document.removeEventListener('mouseup', up); };\n    document.addEventListener('mousemove', move);\n    document.addEventListener('mouseup', up);\n    e.preventDefault();\n  });\n\n  // 拖动/缩放后重绘图表\n  new ResizeObserver(() => {\n    if (trendChart) { trendChart.resize(); modelChart.resize(); costChart.resize(); }\n  }).observe(panel);\n\n  // ---------- 图表 ----------\n  let trendChart = null, modelChart = null, costChart = null;\n  function ensureCharts() {\n    if (trendChart) return;\n    const s = document.createElement('script');\n    s.src = 'https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js';\n    s.onload = () => {\n      trendChart = echarts.init($('#ccu-trend'), 'dark');\n      modelChart = echarts.init($('#ccu-model'), 'dark');\n      costChart = echarts.init($('#ccu-cost'), 'dark');\n      renderAll();\n    };\n    document.head.appendChild(s);\n  }\n\n  // ---------- 渲染 ----------\n  // ---------- 限额（summary 接口 totalCost + GOAT 套餐固定上限） ----------\n  const GOAT_CAPS = [\n    { name: '5-Hour', cap: 14, ms: 5 * 36e5 },\n    { name: 'Weekly', cap: 35, ms: 7 * 864e5 },\n    { name: 'Monthly', cap: 70, ms: 30 * 864e5 },\n  ];\n  let summaryCost = null;\n\n  async function fetchSummaryCost() {\n    try {\n      const res = await fetch(API + '/usage/summary', { credentials: 'include', headers: { accept: 'application/json' } });\n      if (res.ok) summaryCost = (await res.json()).totalCost ?? 0;\n    } catch { /* 保持上次值 */ }\n  }\n\n  function renderLimits() {\n    const el = $('#ccu-limits');\n    if (!el) return;\n    const all = loadRecords();\n    const now = Date.now();\n    el.innerHTML = GOAT_CAPS.map(({ name, cap, ms }) => {\n      // Monthly 优先用 summary 接口的账单周期总额；其它窗口用本地记录按时间窗求和\n      let used;\n      if (name === 'Monthly' && summaryCost != null) used = summaryCost;\n      else used = all.reduce((s, r) => s + (now - new Date(r.createdAt).getTime() <= ms ? r.totalCost : 0), 0);\n      const pct = (used / cap) * 100;\n      const cls = pct >= 90 ? 'danger' : pct >= 60 ? 'warn' : '';\n      return `<div class=\"limit-row\">\n        <span class=\"lname\">${name}</span>\n        <div class=\"bar-bg\"><div class=\"bar-fill ${cls}\" style=\"width:${Math.min(100, pct)}%\"></div></div>\n        <span class=\"lval\">${fmtCost2(used)} / ${fmtCost2(cap)}</span>\n        <span class=\"lpct ${cls}\">${pct.toFixed(1)}%</span>\n      </div>`;\n    }).join('');\n  }\n\n  let rangeDays = 7;\n  function renderAll() {\n    const all = loadRecords();\n    $('#ccu-count').textContent = fmtInt(all.length);\n    renderLimits();\n    const to = Date.now();\n    const from = rangeDays ? to - rangeDays * 864e5 : -Infinity;\n    const rows = all.filter(r => { const t = new Date(r.createdAt).getTime(); return t >= from && t <= to; })\n                    .sort((a, b) => a.createdAt.localeCompare(b.createdAt));\n    if (!rows.length) { $('#ccu-cards').innerHTML = '<div class=\"meta\">该范围无数据</div>'; return; }\n\n    // 卡片\n    const tin = rows.reduce((s, r) => s + r.tokensIn, 0), tout = rows.reduce((s, r) => s + r.tokensOut, 0);\n    const cost = rows.reduce((s, r) => s + r.totalCost, 0);\n    const avgDur = rows.reduce((s, r) => s + r.durationTotal, 0) / rows.length;\n    $('#ccu-cards').innerHTML = [\n      ['请求数', fmtInt(rows.length)], ['Total Tokens', fmtInt(tin + tout)],\n      ['费用', fmtCost2(cost)], ['平均耗时', fmtDur(avgDur)],\n    ].map(([l, v]) => `<div class=\"card\"><div class=\"l\">${l}</div><div class=\"v\">${v}</div></div>`).join('');\n\n    // 趋势图（按数据实际跨度自适应聚合粒度）\n    if (trendChart && rows.length) {\n      const span = new Date(rows[rows.length - 1].createdAt) - new Date(rows[0].createdAt);\n      const bucketMs = span >= 14 * 864e5 ? 864e5      // >14天: 按天\n                     : span >= 2 * 864e5 ? 6 * 36e5    // >2天: 6小时\n                     : span >= 6 * 36e5 ? 36e5         // >6小时: 1小时\n                     : span >= 36e5 ? 6 * 6e4          // >1小时: 10分钟\n                     : 6e4;                            // <1小时: 每分钟\n      const buckets = new Map();\n      for (const r of rows) {\n        const k = Math.floor(new Date(r.createdAt).getTime() / bucketMs) * bucketMs;\n        const b = buckets.get(k) || { in: 0, out: 0, cost: 0 };\n        b.in += r.tokensIn; b.out += r.tokensOut; b.cost += r.totalCost;\n        buckets.set(k, b);\n      }\n      const ks = [...buckets.keys()].sort((a, b) => a - b);\n      trendChart.setOption({\n        backgroundColor: 'transparent',\n        title: { text: 'Token / 费用趋势', textStyle: { fontSize: 12, color: '#8b90a3' } },\n        tooltip: { trigger: 'axis' },\n        legend: { textStyle: { color: '#8b90a3' }, top: 20 },\n        grid: { top: 55, left: 55, right: 50, bottom: 25 },\n        xAxis: { type: 'time', axisLabel: { color: '#8b90a3' } },\n        yAxis: [\n          { type: 'value', axisLabel: { color: '#8b90a3', formatter: v => v >= 1e6 ? v / 1e6 + 'M' : v >= 1e3 ? v / 1e3 + 'k' : v }, splitLine: { lineStyle: { color: '#232735' } } },\n          { type: 'value', axisLabel: { color: '#8b90a3' }, splitLine: { show: false } },\n        ],\n        series: [\n          { name: 'Input', type: 'line', stack: 't', areaStyle: { opacity: .3 }, smooth: true, showSymbol: false, data: ks.map(k => [k, buckets.get(k).in]) },\n          { name: 'Output', type: 'line', stack: 't', areaStyle: { opacity: .3 }, smooth: true, showSymbol: false, data: ks.map(k => [k, buckets.get(k).out]) },\n          { name: 'Cost($)', type: 'line', yAxisIndex: 1, smooth: true, showSymbol: false, lineStyle: { type: 'dashed' }, data: ks.map(k => [k, +buckets.get(k).cost.toFixed(3)]) },\n        ],\n      }, true);\n\n      // 模型占比\n      const byModel = {};\n      for (const r of rows) {\n        byModel[r.model] = byModel[r.model] || { t: 0, c: 0 };\n        byModel[r.model].t += r.tokensIn + r.tokensOut;\n        byModel[r.model].c += r.totalCost;\n      }\n      const entries = Object.entries(byModel).sort((a, b) => b[1].t - a[1].t);\n      const shortName = n => n.length > 14 ? n.slice(0, 12) + '…' : n;\n      modelChart.setOption({\n        backgroundColor: 'transparent',\n        title: { text: '模型占比 (Tokens)', textStyle: { fontSize: 12, color: '#8b90a3' } },\n        tooltip: { trigger: 'item', formatter: p => `${p.name}<br>${fmtInt(p.value)} (${p.percent}%)<br>${fmtCost2(byModel[p.name].c)}` },\n        series: [{ type: 'pie', radius: ['38%', '68%'], center: ['50%', '58%'],\n          label: { color: '#8b90a3', fontSize: 11, width: 70, overflow: 'truncate', formatter: p => `${shortName(p.name)}\\n${p.percent.toFixed(1)}%` },\n          labelLine: { length: 8, length2: 4 },\n          data: entries.map(([name, v]) => ({ name, value: v.t })) }],\n      }, true);\n\n      // 费用分布（按模型）\n      costChart.setOption({\n        backgroundColor: 'transparent',\n        title: { text: '费用分布', textStyle: { fontSize: 12, color: '#8b90a3' } },\n        tooltip: { trigger: 'item', formatter: p => `${p.name}<br>${fmtCost2(p.value)} (${p.percent}%)` },\n        series: [{ type: 'pie', radius: ['38%', '68%'], center: ['50%', '58%'],\n          label: { color: '#8b90a3', fontSize: 11, width: 70, overflow: 'truncate', formatter: p => `${shortName(p.name)}\\n${p.percent.toFixed(1)}%` },\n          labelLine: { length: 8, length2: 4 },\n          data: entries.map(([name, v]) => ({ name, value: +v.c.toFixed(4) })) }],\n      }, true);\n    }\n\n    // 每日费用表\n    const byDay = {};\n    for (const r of rows) {\n      const d = r.createdAt.slice(0, 10);\n      byDay[d] = byDay[d] || { n: 0, tin: 0, tout: 0, cost: 0 };\n      byDay[d].n++; byDay[d].tin += r.tokensIn; byDay[d].tout += r.tokensOut; byDay[d].cost += r.totalCost;\n    }\n    const days = Object.entries(byDay).sort((a, b) => b[0].localeCompare(a[0]));\n    $('#ccu-daily').innerHTML = `<thead><tr><th>日期</th><th>请求</th><th>Input</th><th>Output</th><th>费用</th></tr></thead><tbody>${\n      days.map(([d, v]) => `<tr><td>${d}</td><td>${fmtInt(v.n)}</td><td>${fmtInt(v.tin)}</td><td>${fmtInt(v.tout)}</td><td>${fmtCost(v.cost)}</td></tr>`).join('')\n    }<tr style=\"font-weight:600\"><td>合计</td><td>${fmtInt(rows.length)}</td><td>${fmtInt(tin)}</td><td>${fmtInt(tout)}</td><td>${fmtCost(cost)}</td></tr></tbody>`;\n  }\n\n  // ---------- 事件 ----------\n  document.querySelectorAll('.rng button').forEach(b => {\n    b.onclick = () => {\n      document.querySelectorAll('.rng button').forEach(x => x.classList.remove('active'));\n      b.classList.add('active');\n      rangeDays = Number(b.dataset.r);\n      renderAll();\n    };\n  });\n\n  $('#ccu-sync').onclick = async () => {\n    try {\n      setStatus('同步中...', true);\n      const r = await syncIncremental(setStatus);\n      setStatus(`同步完成: +${r.added} 条 (${r.pages} 页)`);\n      renderLastSync();\n      renderAll();\n    } catch (e) { setStatus('同步失败: ' + e.message); }\n  };\n\n  $('#ccu-export').onclick = () => {\n    const blob = new Blob([JSON.stringify(loadRecords(), null, 2)], { type: 'application/json' });\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(blob);\n    a.download = `cc-usage-${new Date().toISOString().slice(0, 10)}.json`;\n    a.click();\n    URL.revokeObjectURL(a.href);\n  };\n\n  $('#ccu-clear').onclick = () => {\n    if (confirm('确定清空所有已存储的 usage 数据？')) { GM_deleteValue(STORE_KEY); renderAll(); setStatus('已清空'); }\n  };\n\n  // ---------- 启动：自动增量同步 ----------\n  ensureCharts();\n  renderLastSync();\n  fetchSummaryCost().then(renderAll);\n  (async () => {\n    try {\n      setStatus('自动同步中...');\n      const r = await syncIncremental(setStatus);\n      setStatus(r.added ? `自动同步: +${r.added} 条` : '数据已是最新');\n      renderLastSync();\n      renderAll();\n    } catch (e) { setStatus('自动同步失败: ' + e.message); }\n  })();\n})();\n"}