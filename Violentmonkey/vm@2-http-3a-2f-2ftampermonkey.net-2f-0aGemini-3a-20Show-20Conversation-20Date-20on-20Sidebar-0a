{"version":2,"custom":{"origInclude":true,"origExclude":true,"origMatch":true,"origExcludeMatch":true,"origTag":true,"from":"https://greasyfork.org/zh-CN/scripts/569914-gemini-show-conversation-date-on-sidebar","lastInstallURL":"https://update.greasyfork.org/scripts/569914/Gemini%3A%20Show%20Conversation%20Date%20on%20Sidebar.user.js","pathMap":{}},"config":{"enabled":1,"shouldUpdate":1,"removed":0,"noCmdNames":1},"props":{"lastUpdated":1794544766351},"code":"// ==UserScript==\n// @name         Gemini: Show Conversation Date on Sidebar\n// @name:zh-CN   Gemini 侧边栏对话日期显示\n// @namespace    http://tampermonkey.net/\n// @version      1.1.1\n// @description  Displays relative/absolute time in sidebar. Hides dates on hover/active. Includes toggleable theme styles for Tooltip.\n// @description:zh-CN  在 Gemini 侧边栏显示对话最后修改的时间\n// @icon         https://www.gstatic.com/lamda/images/gemini_sparkle_aurora_33f86dc0c0257da337c63.svg\n// @author       Joe_Ye\n// @license      MIT\n// @match        https://gemini.google.com/*\n// @run-at       document-start\n// @grant        GM_setValue\n// @grant        GM_getValue\n// @grant        GM_registerMenuCommand\n// @grant        GM_unregisterMenuCommand\n// @grant        unsafeWindow\n// @downloadURL https://update.greasyfork.org/scripts/569914/Gemini%3A%20Show%20Conversation%20Date%20on%20Sidebar.user.js\n// @updateURL https://update.greasyfork.org/scripts/569914/Gemini%3A%20Show%20Conversation%20Date%20on%20Sidebar.meta.js\n// ==/UserScript==\n\n(function () {\n    'use strict';\n\n    // Ignore the auxiliary /_/bscframe iframe; it has no sidebar.\n    try {\n        if (window.top !== window.self) return;\n    } catch (_) {\n        return;\n    }\n\n    const conversationDates = new Map();\n    let customTooltip = null;\n    let globalTooltipTimer = null;\n\n    // Load preferences\n    let tooltipTheme = GM_getValue('gwd_tooltip_theme', 'dark');\n    let dateFormat = GM_getValue('gwd_date_format', 'yyyy-mm-dd'); // 'yyyy-mm-dd' or 'mm/dd/yyyy'\n    let isMenuExpanded = GM_getValue('gwd_menu_expanded', false);\n\n    let menuIds = [];\n\n    // --- Dynamic & Localized Menu Text ---\n    function getMenuText(key) {\n        const lang = document.documentElement.lang || navigator.language || 'en';\n        const isZh = lang.toLowerCase().includes('zh');\n\n        const dict = {\n            'settingsToggle': isZh\n                ? `⚙️ 侧边栏日期设置 (${isMenuExpanded ? '点击折叠 ⬆️' : '点击展开 ⬇️'})`\n                : `⚙️ Sidebar Date Settings (${isMenuExpanded ? 'Click to collapse ⬆️' : 'Click to expand ⬇️'})`,\n            'theme': isZh\n                ? ` ├─ 🎨 悬浮窗样式: ${tooltipTheme === 'dark' ? '无框大字 (点击切换: 默认)' : '默认适应 (点击切换: 无框大字)'}`\n                : ` ├─ 🎨 Tooltip Theme: ${tooltipTheme === 'dark' ? 'Borderless/Large (Click -> Default)' : 'Default Adaptive (Click -> Borderless)'}`,\n            'format': isZh\n                ? ` └─ 📅 日期格式: ${dateFormat === 'yyyy-mm-dd' ? '年-月-日 (点击切换: 月/日/年)' : '月/日/年 (点击切换: 年-月-日)'}`\n                : ` └─ 📅 Date Format: ${dateFormat === 'yyyy-mm-dd' ? 'YYYY-MM-DD (Click -> MM/DD/YYYY)' : 'MM/DD/YYYY (Click -> YYYY-MM-DD)'}`\n        };\n        return dict[key] || '';\n    }\n\n    // --- Menu Rendering Logic ---\n    function refreshMenu() {\n        menuIds.forEach(id => GM_unregisterMenuCommand(id));\n        menuIds = [];\n\n        const opts = { autoClose: false };\n\n        menuIds.push(GM_registerMenuCommand(getMenuText('settingsToggle'), () => {\n            isMenuExpanded = !isMenuExpanded;\n            GM_setValue('gwd_menu_expanded', isMenuExpanded);\n            refreshMenu();\n        }, opts));\n\n        if (isMenuExpanded) {\n            menuIds.push(GM_registerMenuCommand(getMenuText('theme'), () => {\n                tooltipTheme = tooltipTheme === 'dark' ? 'adaptive' : 'dark';\n                GM_setValue('gwd_tooltip_theme', tooltipTheme);\n                if (customTooltip) {\n                    customTooltip.className = tooltipTheme === 'adaptive' ? 'gwd-theme-adaptive' : 'gwd-theme-dark';\n                }\n                refreshMenu();\n            }, opts));\n\n            menuIds.push(GM_registerMenuCommand(getMenuText('format'), () => {\n                dateFormat = dateFormat === 'yyyy-mm-dd' ? 'mm/dd/yyyy' : 'yyyy-mm-dd';\n                GM_setValue('gwd_date_format', dateFormat);\n                clearAndReRender();\n                refreshMenu();\n            }, opts));\n        }\n    }\n\n    refreshMenu();\n\n    function clearAndReRender() {\n        document.querySelectorAll('.gwd-sidebar-date-wrapper').forEach(el => el.remove());\n        // Fix: relax the selector so it is not limited to anchor tags\n        document.querySelectorAll('[data-test-id=\"conversation\"]').forEach(el => {\n            el.removeAttribute('data-date-injected');\n            const title = el.querySelector('.conversation-title') || el.querySelector('[data-test-id=\"conversation-title\"]');\n            if (title) title.style.paddingRight = '';\n        });\n        updateSidebarDOM();\n    }\n\n    // --- i18n Localization & Plurals ---\n    function getLocString(key, val = '', isTooltip = false) {\n        const lang = document.documentElement.lang || navigator.language || 'en';\n        const isZh = lang.toLowerCase().includes('zh');\n        const suffixZh = isTooltip ? '前' : '';\n        const suffixEn = isTooltip ? ' ago' : '';\n        const plural = (word) => val > 1 ? `${word}s` : word;\n\n        const dict = {\n            'today': isZh ? '今天' : 'Today',\n            'yesterday': isZh ? '昨天' : 'Yesterday',\n            'ereyesterday': isZh ? '前天' : `2 days${suffixEn}`,\n            'days': isZh ? `${val} 天${suffixZh}` : `${val} ${plural('day')}${suffixEn}`,\n            'weeks': isZh ? `${val} 周${suffixZh}` : `${val} ${plural('week')}${suffixEn}`,\n            'months': isZh ? `${val} 个月${suffixZh}` : `${val} ${plural('month')}${suffixEn}`,\n            'years': isZh ? `${val} 年${suffixZh}` : `${val} ${plural('year')}${suffixEn}`,\n        };\n        return dict[key] || '';\n    }\n\n    // --- Lazy Initialization for DOM Elements ---\n    function ensureDOMInitialized() {\n        if (!document.head || !document.body) return false;\n\n        if (!document.getElementById('gwd-global-styles')) {\n            const style = document.createElement('style');\n            style.id = 'gwd-global-styles';\n            style.textContent = `\n                /*a[data-test-id=\"conversation\"]:hover .gwd-sidebar-date-wrapper,\n                a.gwd-is-active .gwd-sidebar-date-wrapper {\n                    display: none !important;\n                }*/\n\n                #gwd-custom-tooltip {\n                    position: fixed;\n                    z-index: 999999;\n                    pointer-events: none;\n                    opacity: 0;\n                    visibility: hidden;\n                    transition: opacity 0.15s ease-in-out;\n                    max-width: 200px;\n                    word-wrap: break-word;\n                    font-size: 13px;\n                }\n                #gwd-custom-tooltip.gwd-show {\n                    opacity: 1;\n                    visibility: visible;\n                }\n                .gwd-tooltip-title {\n                    line-height: 1.4;\n                    margin-bottom: 6px;\n                    font-weight: 500;\n                }\n                .gwd-tooltip-date {\n                    padding-top: 6px;\n                    border-top: 1px solid currentColor;\n                    opacity: 0.75;\n                    font-size: 12px;\n                    font-weight: 400;\n                    white-space: nowrap;\n                }\n                /* =======================================\n                   Theme 1: Dark, Borderless, Large Font\n                   ======================================= */\n                #gwd-custom-tooltip.gwd-theme-dark {\n                    background-color: transparent;\n                    box-shadow: none;\n                    color: var(--gem-sys-color--on-surface, #1f1f1f);\n                    padding: none;\n                    border: none;\n                }\n\n                #gwd-custom-tooltip.gwd-theme-dark .gwd-tooltip-title {\n                    font-size: 16px;\n                    color: var(--gem-sys-color--on-surface, #1f1f1f);\n                }\n\n                /* =======================================\n                     Theme 2: Default Theme\n                   ======================================= */\n                #gwd-custom-tooltip.gwd-theme-adaptive {\n                    background-color: var(--gem-sys-color--surface, #f3f4f6);\n                    color: var(--gem-sys-color--on-surface, #1f1f1f);\n                    border: 1px solid var(--gem-sys-color--outline-variant, #c4c7c5);\n                    border-radius: 8px;\n                    padding: 8px 12px;\n                    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);\n                }\n            `;\n            document.head.appendChild(style);\n        }\n\n        if (!customTooltip) {\n            customTooltip = document.getElementById('gwd-custom-tooltip');\n            if (!customTooltip) {\n                customTooltip = document.createElement('div');\n                customTooltip.id = 'gwd-custom-tooltip';\n                customTooltip.className = tooltipTheme === 'adaptive' ? 'gwd-theme-adaptive' : 'gwd-theme-dark';\n                document.body.appendChild(customTooltip);\n            }\n        }\n        return true;\n    }\n\n    // --- Time Formatters ---\n    function getRelativeTime(targetDate, isTooltip = false) {\n        const now = new Date();\n        const todayMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate());\n        const targetMidnight = new Date(targetDate.getFullYear(), targetDate.getMonth(), targetDate.getDate());\n        const diffMs = todayMidnight - targetMidnight;\n        const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));\n\n        if (diffDays <= 0) return getLocString('today', '', isTooltip);\n        if (diffDays === 1) return getLocString('yesterday', '', isTooltip);\n        if (diffDays === 2) return getLocString('ereyesterday', '', isTooltip);\n        if (diffDays >= 3 && diffDays < 7) return getLocString('days', diffDays, isTooltip);\n        if (diffDays >= 7 && diffDays < 30) return getLocString('weeks', Math.floor(diffDays / 7), isTooltip);\n\n        const diffMonths = (now.getFullYear() - targetDate.getFullYear()) * 12 + now.getMonth() - targetDate.getMonth();\n        if (diffMonths > 0 && diffMonths < 12) return getLocString('months', diffMonths, isTooltip);\n\n        const diffYears = now.getFullYear() - targetDate.getFullYear();\n        return getLocString('years', diffYears, isTooltip);\n    }\n\n    function formatAbsoluteTime(d) {\n        const yyyy = d.getFullYear();\n        const MM = String(d.getMonth() + 1).padStart(2, '0');\n        const dd = String(d.getDate()).padStart(2, '0');\n        const mm = String(d.getMinutes()).padStart(2, '0');\n\n        if (dateFormat === 'mm/dd/yyyy') {\n            const h12 = d.getHours() % 12 || 12;\n            const ampm = d.getHours() >= 12 ? 'PM' : 'AM';\n            return `${MM}/${dd}/${yyyy} ${h12}:${mm} ${ampm}`;\n        }\n\n        const HH = String(d.getHours()).padStart(2, '0');\n        return `${yyyy}-${MM}-${dd} ${HH}:${mm}`;\n    }\n\n    function normalizeResponseText(text) {\n        // batchexecute responses can contain escaped JSON inside a JSON string.\n        return String(text)\n            .replace(/\\\\u0022/g, '\"')\n            .replace(/\\\\\"/g, '\"')\n            .replace(/\\\\u005b/g, '[')\n            .replace(/\\\\u005d/g, ']');\n    }\n\n    function normalizeTimestamp(raw) {\n        const value = Number(raw);\n        if (!Number.isFinite(value)) return null;\n\n        // Accept both Unix seconds and Unix milliseconds.\n        const seconds = value > 1e12 ? Math.floor(value / 1000) : Math.floor(value);\n        const min = 946684800;   // 2000-01-01\n        const max = 4102444800;  // 2100-01-01\n        return seconds >= min && seconds <= max ? seconds : null;\n    }\n\n    function extractTimestamps(text) {\n        if (!text) return;\n\n        const normalized = normalizeResponseText(text);\n        const idPattern = /[\"']?c_([a-zA-Z0-9_-]{8,})/g;\n        let newDatesFound = false;\n        let idMatch;\n\n        while ((idMatch = idPattern.exec(normalized))) {\n            const id = idMatch[1];\n            const blockStart = idPattern.lastIndex;\n            const rest = normalized.slice(blockStart);\n            const nextIdOffset = rest.search(/[\"']?c_[a-zA-Z0-9_-]{8,}/);\n            const blockEnd = nextIdOffset >= 0\n                ? blockStart + nextIdOffset\n                : Math.min(normalized.length, blockStart + 8192);\n            const block = normalized.slice(blockStart, blockEnd);\n\n            // The old response used [seconds, ...]. New responses may use\n            // milliseconds, quoted numbers, or a comma-delimited field.\n            const timestampPattern = /(?:\\[|,)\\s*[\"']?(\\d{10,13})[\"']?(?=\\s*[,\\]}])/g;\n            let timestamp = null;\n            let tsMatch;\n            while ((tsMatch = timestampPattern.exec(block))) {\n                timestamp = normalizeTimestamp(tsMatch[1]);\n                if (timestamp !== null) break;\n            }\n\n            if (timestamp !== null && !conversationDates.has(id)) {\n                conversationDates.set(id, timestamp);\n                newDatesFound = true;\n            }\n        }\n\n        if (newDatesFound) updateSidebarDOM();\n    }\n\n    // ---------- Initial list refresh fallback ----------\n    // The first MaZiqc request can finish before a userscript hook is ready.\n    // Re-issue the same request once the page has exposed its current WIZ\n    // tokens, so the date map does not depend on interception timing.\n    let fallbackRequestAttempts = 0;\n    let fallbackRequestInFlight = false;\n\n    function getPageGlobalValue(key) {\n        try {\n            const pageWindow = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;\n            const value = pageWindow && pageWindow.WIZ_global_data && pageWindow.WIZ_global_data[key];\n            if (value !== undefined && value !== null && value !== '') return String(value);\n        } catch (_) { }\n\n        const html = document.documentElement && document.documentElement.innerHTML || '';\n        const escapedKey = key.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n        const match = html.match(new RegExp(`\"${escapedKey}\"\\\\s*:\\\\s*(?:\"([^\"]*)\"|(-?\\\\d+))`));\n        return match ? (match[1] || match[2] || '') : '';\n    }\n\n    function requestConversationDatesFallback() {\n        if (conversationDates.size || fallbackRequestInFlight || fallbackRequestAttempts >= 5) return;\n\n        const at = getPageGlobalValue('SNlM0e');\n        const sid = getPageGlobalValue('FdrFJe');\n        const build = getPageGlobalValue('cfb2h');\n\n        if (!at) {\n            fallbackRequestAttempts++;\n            setTimeout(requestConversationDatesFallback, 1000);\n            return;\n        }\n\n        fallbackRequestAttempts++;\n        fallbackRequestInFlight = true;\n\n        const params = new URLSearchParams({\n            rpcids: 'MaZiqc',\n            'source-path': '/app',\n            hl: document.documentElement.lang || navigator.language || 'en',\n            _reqid: String(Math.floor(Math.random() * 900000) + 100000),\n            rt: 'c',\n        });\n        if (sid) params.set('f.sid', sid);\n        if (build) params.set('bl', build);\n\n        const body = new URLSearchParams();\n        body.set('f.req', '[[[\"MaZiqc\",\"[30,null,[null,null,1,null,null,null,null,null,null,1]]\",null,\"generic\"]]]');\n        body.set('at', at);\n\n        fetch(`${location.origin}/_/BardChatUi/data/batchexecute?${params.toString()}`, {\n            method: 'POST',\n            credentials: 'include',\n            headers: {\n                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',\n                'X-Same-Domain': '1',\n            },\n            body: body.toString(),\n        })\n            .then((response) => {\n                if (!response.ok) throw new Error(`MaZiqc HTTP ${response.status}`);\n                return response.text();\n            })\n            .then((text) => extractTimestamps(text))\n            .catch(() => { })\n            .finally(() => {\n                fallbackRequestInFlight = false;\n                if (!conversationDates.size && fallbackRequestAttempts < 5) {\n                    setTimeout(requestConversationDatesFallback, 1500);\n                }\n            });\n    }\n\n    setTimeout(requestConversationDatesFallback, 1500);\n\n    // --- Core DOM Updater ---\n    function updateSidebarDOM() {\n        if (!ensureDOMInitialized()) return;\n\n        // Fix 1: remove the hard dependency on gem-nav-list-item and use data-test-id directly\n        const items = document.querySelectorAll('[data-test-id=\"conversation\"]');\n        const currentPath = window.location.pathname;\n\n        items.forEach(item => {\n            // Fix 2: handle cases where the item itself is an anchor or the anchor is a child element\n            const aNode = item.tagName.toLowerCase() === 'a' ? item : item.querySelector('a');\n            const href = aNode ? aNode.getAttribute('href') : null;\n\n            if (href && href === currentPath) {\n                item.classList.add('gwd-is-active');\n            } else {\n                item.classList.remove('gwd-is-active');\n            }\n\n            item.removeAttribute('mattooltip');\n            item.classList.remove('mat-mdc-tooltip-trigger');\n\n            if (item.hasAttribute('data-date-injected')) return;\n            if (!href) return;\n\n            const idMatch = href.match(/\\/app\\/([a-zA-Z0-9_-]+)/);\n            if (!idMatch) return;\n            const id = idMatch[1];\n\n            if (!item.hasAttribute('data-gwd-hover-bound')) {\n                const blockNative = (e) => e.stopImmediatePropagation();\n                item.addEventListener('mouseover', blockNative, true);\n                item.addEventListener('focus', blockNative, true);\n                item.addEventListener('blur', blockNative, true);\n\n                item.addEventListener('mouseenter', (e) => {\n                    e.stopImmediatePropagation();\n                    item.removeAttribute('mattooltip');\n                    clearTimeout(globalTooltipTimer);\n\n                    if (!conversationDates.has(id)) return;\n                    const d = new Date(conversationDates.get(id) * 1000);\n\n                    // Fix 3: use multiple fallback selectors to find the title container\n                    const titleContainer = item.querySelector('.conversation-title')\n                        || item.querySelector('[data-test-id=\"conversation-title\"]')\n                        || item;\n\n                    // Fix 4: extract text more safely by cloning the node and removing our injected date elements\n                    let pureTitle = 'Conversation';\n                    if (titleContainer) {\n                        const clone = titleContainer.cloneNode(true);\n                        const injectedDates = clone.querySelectorAll('.gwd-sidebar-date-wrapper');\n                        injectedDates.forEach(node => node.remove());\n                        pureTitle = clone.textContent.replace(/\\s+/g, ' ').trim() || 'Conversation';\n                    }\n\n                    const relTooltip = getRelativeTime(d, true);\n                    const abs = formatAbsoluteTime(d);\n\n                    customTooltip.innerHTML = `\n                        <div class=\"gwd-tooltip-title\">${pureTitle}</div>\n                        <div class=\"gwd-tooltip-date\">${relTooltip} · ${abs}</div>\n                    `;\n\n                    globalTooltipTimer = setTimeout(() => {\n                        customTooltip.classList.add('gwd-show');\n                        const rect = item.getBoundingClientRect();\n                        const tRect = customTooltip.getBoundingClientRect();\n                        customTooltip.style.top = `${rect.top + (rect.height / 2) - (tRect.height / 2)}px`;\n                        customTooltip.style.left = `${rect.right + 20}px`;\n                    }, 100);\n                }, true);\n\n                item.addEventListener('mouseleave', (e) => {\n                    e.stopImmediatePropagation();\n                    clearTimeout(globalTooltipTimer);\n                    if (customTooltip) customTooltip.classList.remove('gwd-show');\n                }, true);\n\n                item.setAttribute('data-gwd-hover-bound', 'true');\n            }\n\n            // --- Render Side Dates ---\n            if (conversationDates.has(id)) {\n                const ts = conversationDates.get(id);\n                const d = new Date(ts * 1000);\n                const relativeStr = getRelativeTime(d, false);\n                const absoluteStr = formatAbsoluteTime(d);\n\n                item.style.position = 'relative';\n                const wrapperDiv = document.createElement('div');\n                wrapperDiv.className = 'gwd-sidebar-date-wrapper';\n\n                item.classList.add('gwd-split-mode');\n                wrapperDiv.style.cssText = `\n    display: flex; flex-direction: column; align-items: flex-end; justify-content: center;\n    flex-shrink: 0; margin-left: auto; padding-left: 8px; pointer-events: none;\n`;\n\n                const relDiv = document.createElement('div');\n                relDiv.textContent = relativeStr;\n                relDiv.style.cssText = `\n    font-size: 13px; font-weight: 500;\n    color: var(--gmpx-color-on-surface-variant, #888); line-height: 1.2;\n`;\n                wrapperDiv.appendChild(relDiv);\n\n                // Fix 5: support the new DOM tree structure when inserting the sidebar date\n                const aTag = item.querySelector('a.mat-mdc-list-item') || item.querySelector('a') || item;\n                const metaTag = item.querySelector('.mat-mdc-list-item-meta') || aTag.querySelector(':scope > *:last-child');\n\n                if (aTag && aTag !== item) {\n                    if (metaTag && metaTag.parentNode === aTag) {\n                        aTag.insertBefore(wrapperDiv, metaTag);\n                    } else {\n                        aTag.appendChild(wrapperDiv);\n                    }\n                } else {\n                    item.appendChild(wrapperDiv);\n                }\n\n                item.setAttribute('data-date-injected', 'true');\n            }\n        });\n    }\n\n    // ---------- Network Interception ----------\n    function isTargetUrl(url) {\n        const u = (url || '').toString();\n        // The RPC id is not stable. Keep the endpoint match, and let the\n        // parser decide whether a response contains conversation timestamps.\n        return u.includes('batchexecute');\n    }\n\n    // Tampermonkey runs this file in an isolated world. Hook the page's\n    // native objects through unsafeWindow; patching the sandbox's window does\n    // not see requests issued by Gemini when the sidebar is scrolled.\n    const pageWindow = typeof unsafeWindow !== 'undefined' && unsafeWindow\n        ? unsafeWindow\n        : window;\n    const hookState = pageWindow.__gwdNetworkHookState || (pageWindow.__gwdNetworkHookState = {});\n\n    function getRequestUrl(input) {\n        if (typeof input === 'string') return input;\n        if (input && typeof input.url === 'string') return input.url;\n        if (input && typeof input.href === 'string') return input.href;\n        return input == null ? '' : String(input);\n    }\n\n    function readXhrResponse(xhr) {\n        const responseType = xhr.responseType || '';\n        if (responseType === '' || responseType === 'text') return xhr.responseText;\n        if (responseType === 'json') return JSON.stringify(xhr.response);\n        if (responseType === 'arraybuffer' && xhr.response && typeof TextDecoder === 'function') {\n            return new TextDecoder().decode(xhr.response);\n        }\n        if (responseType === 'blob' && xhr.response && typeof xhr.response.text === 'function') {\n            return xhr.response.text();\n        }\n        return '';\n    }\n\n    function captureXhrResponse(xhr) {\n        if (xhr.__gwdParsed) return;\n        xhr.__gwdParsed = true;\n\n        try {\n            const body = readXhrResponse(xhr);\n            if (body && typeof body.then === 'function') {\n                body.then((text) => extractTimestamps(text)).catch(() => { });\n            } else if (body) {\n                extractTimestamps(body);\n            }\n        } catch (_) {\n            // Some responseTypes cannot be read after an error; leave the\n            // page request untouched and let the next response be handled.\n            xhr.__gwdParsed = false;\n        }\n    }\n\n    if (!hookState.xhr && pageWindow.XMLHttpRequest && pageWindow.XMLHttpRequest.prototype) {\n        const pageXHR = pageWindow.XMLHttpRequest;\n        const nativeOpen = pageXHR.prototype.open;\n        const nativeSend = pageXHR.prototype.send;\n\n        pageXHR.prototype.open = function (method, url) {\n            this.__gwdReqUrl = url;\n            return nativeOpen.apply(this, arguments);\n        };\n\n        pageXHR.prototype.send = function (...args) {\n            const xhr = this;\n            const url = getRequestUrl(xhr.__gwdReqUrl);\n\n            if (isTargetUrl(url)) {\n                try {\n                    xhr.addEventListener('loadend', () => captureXhrResponse(xhr), { once: true });\n                } catch (_) { }\n            }\n\n            return nativeSend.apply(xhr, args);\n        };\n\n        hookState.xhr = true;\n    }\n\n    if (!hookState.fetch && typeof pageWindow.fetch === 'function') {\n        const nativeFetch = pageWindow.fetch;\n        const wrappedFetch = function (input, init) {\n            const url = getRequestUrl(input);\n            const result = nativeFetch.apply(this, arguments);\n\n            if (!isTargetUrl(url)) return result;\n\n            return result.then((response) => {\n                try {\n                    const clone = response.clone();\n                    clone.text().then((text) => extractTimestamps(text)).catch(() => { });\n                } catch (_) { }\n                return response;\n            });\n        };\n\n        wrappedFetch.__gwdOriginal = nativeFetch;\n        pageWindow.fetch = wrappedFetch;\n        hookState.fetch = true;\n    }\n\n    // ---------- DOM Observer ----------\n    let lastUrl = location.href;\n    new MutationObserver(() => {\n        const url = location.href;\n        if (url !== lastUrl) {\n            lastUrl = url;\n            updateSidebarDOM();\n        }\n    }).observe(document, { subtree: true, childList: true });\n\n    const observer = new MutationObserver(() => updateSidebarDOM());\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', () => observer.observe(document.body, { childList: true, subtree: true }));\n    } else {\n        observer.observe(document.body, { childList: true, subtree: true });\n    }\n})();\n"}