{"version":2,"custom":{"origInclude":true,"origExclude":true,"origMatch":true,"origExcludeMatch":true,"origTag":true,"from":"https://greasyfork.org/zh-CN/scripts/575742-gpt-gemini%E6%97%B6%E9%97%B4%E8%BD%B4","lastInstallURL":"https://update.greasyfork.org/scripts/575742/GPT%2BGemini%E6%97%B6%E9%97%B4%E8%BD%B4.user.js","pathMap":{}},"config":{"enabled":1,"shouldUpdate":1,"removed":0},"props":{"lastUpdated":1794544690347},"code":"// ==UserScript==\n// @name         GPT+Gemini时间轴\n// @namespace    https://chatgpt.com/\n// @version      1.1.5\n// @description  ChatGPT/Gemini右侧透明问题时间轴，点击精准定位到用户问题气泡，并贴合气泡外表面高亮\n// @author       BQC\n// @match        https://chatgpt.com/*\n// @match        https://chat.openai.com/*\n// @match        https://*.chatgpt.com/*\n// @match        https://gemini.google.com/*\n// @match        https://*.gemini.google.com/*\n// @grant        none\n// @license      MIT\n// @run-at       document-end\n// @downloadURL https://update.greasyfork.org/scripts/575742/GPT%2BGemini%E6%97%B6%E9%97%B4%E8%BD%B4.user.js\n// @updateURL https://update.greasyfork.org/scripts/575742/GPT%2BGemini%E6%97%B6%E9%97%B4%E8%BD%B4.meta.js\n// ==/UserScript==\n\n(function () {\n    'use strict';\n\n    const ROOT_ID = 'cgpt-mini-timeline';\n    const TOOLTIP_ID = 'cgpt-mini-tooltip';\n    const DESIRED_TOP = 170;\n\n    let questions = [];\n    let activeIndex = -1;\n    let hoverIndex = -1;\n    let refreshTimer = null;\n    let lastSignature = null;\n\n    function waitForBody(callback) {\n        if (document.body) callback();\n        else setTimeout(() => waitForBody(callback), 300);\n    }\n\n    waitForBody(init);\n\n    function refreshQuestionsBurst() {\n    const delays = [300, 800, 1500, 3000, 5000, 8000, 12000];\n\n    delays.forEach(delay => {\n        setTimeout(() => {\n            lastSignature = null;\n            refreshQuestions();\n        }, delay);\n    });\n}\n\n\n    function init() {\n\n    document.getElementById(ROOT_ID)?.remove();\n    document.getElementById(TOOLTIP_ID)?.remove();\n\n        if (document.getElementById(ROOT_ID)) return;\n\n        createStyle();\n        createMiniTimeline();\n\n        setTimeout(refreshQuestions, 500);\n        setTimeout(refreshQuestions, 1500);\n        setTimeout(refreshQuestions, 3000);\n        setTimeout(refreshQuestions, 5000);\n        setInterval(refreshQuestions, 1500);\n        document.addEventListener('click', () => {\n            if (isGeminiPage()) {\n                refreshQuestionsBurst();\n            }\n        }, true);\n\n        document.addEventListener('keydown', event => {\n            if (isGeminiPage() && event.key === 'Enter' && !event.shiftKey) {\n                refreshQuestionsBurst();\n            }\n        }, true);\n\n        const observer = new MutationObserver(() => {\n            clearTimeout(refreshTimer);\n            refreshTimer = setTimeout(refreshQuestions, 600);\n        });\n\n        observer.observe(document.body, {\n            childList: true,\n            subtree: true,\n            characterData: true\n        });\n\n        window.addEventListener('scroll', () => {\n            window.requestAnimationFrame(detectActiveQuestion);\n        }, { passive: true });\n\n        document.addEventListener('scroll', () => {\n            window.requestAnimationFrame(detectActiveQuestion);\n        }, true);\n\n        window.addEventListener('resize', () => {\n            window.requestAnimationFrame(detectActiveQuestion);\n        }, { passive: true });\n    }\n\n    function createStyle() {\n        const style = document.createElement('style');\n\n        style.textContent = `\n            #${ROOT_ID} {\n                position: fixed !important;\n                right: 24px !important;\n                top: 50% !important;\n                transform: translateY(-50%) !important;\n                width: 78px !important;\n                max-height: 84vh !important;\n                z-index: 2147483647 !important;\n                display: flex !important;\n                align-items: center !important;\n                justify-content: flex-end !important;\n                user-select: none !important;\n                background: transparent !important;\n                border: none !important;\n                box-shadow: none !important;\n                pointer-events: none !important;\n                overflow: visible !important;\n            }\n\n            #${ROOT_ID} .mini-track {\n                width: 74px !important;\n                max-height: 84vh !important;\n                display: flex !important;\n                flex-direction: column !important;\n                gap: 7px !important;\n                justify-content: center !important;\n                align-items: flex-end !important;\n                padding: 6px 0 !important;\n                box-sizing: border-box !important;\n                background: transparent !important;\n                border: none !important;\n                box-shadow: none !important;\n                pointer-events: none !important;\n                overflow-y: auto !important;\n                overflow-x: visible !important;\n                scrollbar-width: none !important;\n            }\n\n            #${ROOT_ID} .mini-track::-webkit-scrollbar {\n                display: none !important;\n            }\n\n            #${ROOT_ID} .mini-item {\n                width: 70px !important;\n                height: 16px !important;\n                flex: 0 0 auto !important;\n                display: flex !important;\n                align-items: center !important;\n                justify-content: flex-end !important;\n                cursor: pointer !important;\n                pointer-events: auto !important;\n                background: transparent !important;\n                border: none !important;\n                overflow: visible !important;\n                transform: none !important;\n            }\n\n            #${ROOT_ID} .mini-tick {\n                width: 32px !important;\n                height: 5px !important;\n                border-radius: 999px !important;\n                background: #c5c5c5 !important;\n                opacity: 0.96 !important;\n                pointer-events: none !important;\n                transform-origin: right center !important;\n                transform: translateX(0) translateY(0) scaleX(1) scaleY(1) !important;\n                transition:\n                    transform 0.18s ease,\n                    background 0.18s ease,\n                    box-shadow 0.18s ease,\n                    opacity 0.18s ease !important;\n            }\n\n            #${ROOT_ID} .mini-item.hovered .mini-tick {\n                transform: translateX(-7px) translateY(0) scaleX(1.25) scaleY(1.35) !important;\n                background: #555555 !important;\n                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.24) !important;\n                opacity: 1 !important;\n            }\n\n            #${ROOT_ID} .mini-item.move-up .mini-tick {\n                transform: translateX(0) translateY(-6px) scaleX(1) scaleY(1) !important;\n            }\n\n            #${ROOT_ID} .mini-item.move-down .mini-tick {\n                transform: translateX(0) translateY(6px) scaleX(1) scaleY(1) !important;\n            }\n\n            #${ROOT_ID} .mini-item.active .mini-tick {\n                background: #111111 !important;\n                opacity: 1 !important;\n                box-shadow: 0 2px 7px rgba(0, 0, 0, 0.22) !important;\n            }\n\n            #${ROOT_ID} .mini-item.active.hovered .mini-tick {\n                transform: translateX(-8px) translateY(0) scaleX(1.3) scaleY(1.4) !important;\n                background: #000000 !important;\n                box-shadow: 0 3px 10px rgba(0, 0, 0, 0.3) !important;\n            }\n\n            #${ROOT_ID} .mini-item.empty {\n                cursor: default !important;\n            }\n\n            #${ROOT_ID} .mini-item.empty .mini-tick {\n                width: 32px !important;\n                height: 5px !important;\n                background: #d8d8d8 !important;\n                transform: none !important;\n                box-shadow: none !important;\n            }\n\n            #${TOOLTIP_ID} {\n                position: fixed !important;\n                z-index: 2147483647 !important;\n                max-width: 330px !important;\n                background: rgba(235, 235, 235, 0.96) !important;\n                color: #111111 !important;\n                font-size: 12px !important;\n                line-height: 1.5 !important;\n                padding: 8px 10px !important;\n                border-radius: 8px !important;\n                border: 1px solid rgba(0, 0, 0, 0.12) !important;\n                box-shadow: 0 6px 18px rgba(0,0,0,0.18) !important;\n                pointer-events: none !important;\n                opacity: 0 !important;\n                transform: translateY(-50%) !important;\n                transition: opacity 0.16s ease !important;\n                word-break: break-word !important;\n            }\n\n            #${TOOLTIP_ID}.show {\n                opacity: 1 !important;\n            }\n\n            .cgpt-question-bubble-highlight {\n                outline: none !important;\n                border-radius: var(--cgpt-highlight-radius, 18px) !important;\n                box-shadow:\n                    0 0 0 2px rgba(20, 20, 20, 0.72),\n                    0 0 0 5px rgba(20, 20, 20, 0.08) !important;\n                transition:\n                    box-shadow 0.18s ease,\n                    border-radius 0.18s ease !important;\n            }\n        `;\n\n        document.head.appendChild(style);\n    }\n\n   function createMiniTimeline() {\n    const root = document.createElement('div');\n    root.id = ROOT_ID;\n\n    const track = document.createElement('div');\n    track.className = 'mini-track';\n\n    root.appendChild(track);\n    document.body.appendChild(root);\n\n    const tooltip = document.createElement('div');\n    tooltip.id = TOOLTIP_ID;\n    document.body.appendChild(tooltip);\n}\n\n\n   function refreshQuestions() {\n    const newQuestions = findQuestions();\n    const signature = newQuestions.map((q, i) => `${i}:${q.text}`).join('|');\n\n    questions = newQuestions;\n\n    if (signature !== lastSignature) {\n        lastSignature = signature;\n        renderTicks();\n\n        const track = document.querySelector(`#${ROOT_ID} .mini-track`);\n        if (track) {\n            track.scrollTop = track.scrollHeight;\n        }\n    }\n\n    detectActiveQuestion();\n}\n\n\n    function findQuestions() {\n        if (isGeminiPage()) {\n            const geminiQuestions = findGeminiQuestions();\n            return geminiQuestions;\n        }\n\n        const result = [];\n        const seen = new Set();\n\n        const userNodes = Array.from(\n            document.querySelectorAll('[data-message-author-role=\"user\"]')\n        );\n\n        userNodes.forEach(node => {\n            const text = cleanText(node.innerText || node.textContent || '');\n            if (!text || seen.has(text)) return;\n\n            seen.add(text);\n\n            const scrollElement =\n                findBubbleElement(node) ||\n                node.closest('article') ||\n                node.closest('[data-testid^=\"conversation-turn\"]') ||\n                node;\n\n            const bubbleElement =\n                findBubbleElement(node) ||\n                scrollElement;\n\n            result.push({ text, scrollElement, bubbleElement });\n        });\n\n        if (result.length === 0) {\n            const articles = Array.from(document.querySelectorAll('article'));\n\n            articles.forEach(article => {\n                const rawText = cleanText(article.innerText || article.textContent || '');\n                if (!rawText || seen.has(rawText)) return;\n\n                seen.add(rawText);\n\n                result.push({\n                    text: rawText,\n                    scrollElement: article,\n                    bubbleElement: article\n                });\n            });\n        }\n\n        return result;\n    }\n\n    function isGeminiPage() {\n        return location.hostname === 'gemini.google.com' ||\n            location.hostname.endsWith('.gemini.google.com');\n    }\n\n function findGeminiQuestions() {\n    const result = [];\n    const seenElements = new WeakSet();\n\n    const nodes = Array.from(document.querySelectorAll([\n        'user-query',\n        '[data-test-id=\"user-query\"]',\n        '[data-testid=\"user-query\"]',\n        '[class*=\"query-content\"]',\n        '[class*=\"query-text\"]',\n        '.query-text-line'\n    ].join(',')));\n\n    nodes.forEach(node => {\n        if (!(node instanceof HTMLElement)) return;\n        if (node.closest(`#${ROOT_ID}`) || node.id === TOOLTIP_ID) return;\n        if (node.closest('model-response') || node.closest('[class*=\"model-response\"]')) return;\n\n        const userQuery = node.closest('user-query') ||\n            node.closest('[data-test-id=\"user-query\"]') ||\n            node.closest('[data-testid=\"user-query\"]');\n\n        let bubbleElement = null;\n\n        if (userQuery) {\n            bubbleElement =\n                userQuery.querySelector('[class*=\"query-content\"]') ||\n                userQuery.querySelector('[class*=\"query-text\"]') ||\n                userQuery.querySelector('.query-text-line') ||\n                userQuery;\n        } else {\n            bubbleElement =\n                node.closest('[class*=\"query-content\"]') ||\n                node.closest('[class*=\"query-text\"]') ||\n                node;\n        }\n\n        if (!bubbleElement || !(bubbleElement instanceof HTMLElement)) return;\n        if (seenElements.has(bubbleElement)) return;\n\n        const textElement =\n            bubbleElement.querySelector('.query-text-line') ||\n            bubbleElement.querySelector('[class*=\"query-text\"]') ||\n            bubbleElement;\n\n        const text = cleanText(textElement.innerText || textElement.textContent || '');\n\n        if (!text || isGeminiUiText(text)) return;\n\n        seenElements.add(bubbleElement);\n\n        result.push({\n            text,\n            scrollElement: bubbleElement,\n            bubbleElement\n        });\n    });\n\n    return result;\n}\n\n\n    function isGeminiUiText(text) {\n        const value = cleanText(text).toLowerCase();\n\n        if (!value || value.length <= 1) return true;\n\n        return /^(copy|edit|delete|share|more|复制|编辑|删除|分享|更多|修改|收起|展开)$/.test(value);\n    }\n\n    function findBubbleElement(userNode) {\n        const textElement = findMainTextElement(userNode);\n\n        if (!textElement) {\n            return userNode;\n        }\n\n        let current = textElement;\n        let best = textElement;\n\n        while (current && current !== userNode.parentElement) {\n            if (!userNode.contains(current) && current !== userNode) break;\n\n            const rect = current.getBoundingClientRect();\n            const style = window.getComputedStyle(current);\n\n            const bg = style.backgroundColor;\n            const radius =\n                parseFloat(style.borderTopLeftRadius) ||\n                parseFloat(style.borderRadius) ||\n                0;\n\n            const paddingLeft = parseFloat(style.paddingLeft) || 0;\n            const paddingRight = parseFloat(style.paddingRight) || 0;\n            const paddingTop = parseFloat(style.paddingTop) || 0;\n            const paddingBottom = parseFloat(style.paddingBottom) || 0;\n\n            const hasVisibleSize = rect.width > 30 && rect.height > 15;\n            const hasBubbleBg = isVisibleBackground(bg);\n            const hasRoundCorner = radius >= 8;\n            const hasPadding = paddingLeft + paddingRight >= 12 || paddingTop + paddingBottom >= 8;\n\n            if (hasVisibleSize && (hasBubbleBg || hasRoundCorner || hasPadding)) {\n                best = current;\n            }\n\n            if (hasVisibleSize && hasBubbleBg && hasRoundCorner) {\n                return current;\n            }\n\n            if (current === userNode) break;\n            current = current.parentElement;\n        }\n\n        return best || userNode;\n    }\n\n    function findMainTextElement(userNode) {\n        const selectors = [\n            '[data-message-content]',\n            '[data-testid=\"message_text_content\"]',\n            '.whitespace-pre-wrap',\n            '.markdown',\n            'p',\n            'div'\n        ];\n\n        for (const selector of selectors) {\n            const candidates = Array.from(userNode.querySelectorAll(selector))\n                .filter(el => {\n                    const text = cleanText(el.innerText || el.textContent || '');\n                    const rect = el.getBoundingClientRect();\n                    return text.length > 0 && rect.width > 20 && rect.height > 8;\n                });\n\n            if (candidates.length) {\n                candidates.sort((a, b) => {\n                    const ar = a.getBoundingClientRect();\n                    const br = b.getBoundingClientRect();\n                    return (ar.width * ar.height) - (br.width * br.height);\n                });\n\n                return candidates[0];\n            }\n        }\n\n        return userNode;\n    }\n\n    function isVisibleBackground(bg) {\n        if (!bg) return false;\n        if (bg === 'transparent') return false;\n        if (bg === 'rgba(0, 0, 0, 0)') return false;\n        return true;\n    }\n\n    function cleanText(text) {\n        return text\n            .replace(/\\s+/g, ' ')\n            .replace(/^You said:?\\s*/i, '')\n            .replace(/^你说：?\\s*/i, '')\n            .replace(/^您说：?\\s*/i, '')\n            .trim();\n    }\n\n    function shortText(text, max = 120) {\n        if (text.length <= max) return text;\n        return text.slice(0, max) + '...';\n    }\n\n function renderTicks() {\n    const root = document.getElementById(ROOT_ID);\n    if (!root) return;\n\n    const track = root.querySelector('.mini-track');\n    track.replaceChildren();\n\n    if (!questions.length) {\n        for (let i = 0; i < 20; i++) {\n            const item = document.createElement('div');\n            item.className = 'mini-item empty';\n\n            const tick = document.createElement('div');\n            tick.className = 'mini-tick';\n\n            item.appendChild(tick);\n            track.appendChild(item);\n        }\n        return;\n    }\n\n    questions.forEach((question, index) => {\n        const item = document.createElement('div');\n        item.className = 'mini-item';\n        item.dataset.index = index;\n\n        const tick = document.createElement('div');\n        tick.className = 'mini-tick';\n\n        item.appendChild(tick);\n\n        item.addEventListener('click', () => {\n            jumpToQuestion(index);\n        });\n\n        item.addEventListener('mouseenter', () => {\n            hoverIndex = index;\n            updateHoverState();\n            showTooltip(shortText(question.text, 120), item);\n        });\n\n        item.addEventListener('mouseleave', () => {\n            hoverIndex = -1;\n            updateHoverState();\n            hideTooltip();\n        });\n\n        track.appendChild(item);\n    });\n\n    updateActiveTick();\n    updateHoverState();\n}\n\n    function jumpToQuestion(index) {\n        const item = questions[index];\n        if (!item) return;\n\n        const target = item.bubbleElement || item.scrollElement;\n        if (!target) return;\n\n        activeIndex = index;\n        updateActiveTick();\n        hideTooltip();\n\n        preciseScrollTo(target);\n\n        setTimeout(() => {\n            highlightBubble(target);\n        }, 260);\n    }\n\n    function preciseScrollTo(targetElement) {\n        const scroller = findScrollParent(targetElement);\n\n        if (isGeminiPage() && targetElement.scrollIntoView) {\n            targetElement.scrollIntoView({\n                block: 'center',\n                behavior: 'auto'\n            });\n        }\n\n        const delays = [0, 80, 180, 320, 520, 760];\n\n        delays.forEach(delay => {\n            setTimeout(() => {\n                correctScrollPosition(targetElement, scroller);\n            }, delay);\n        });\n    }\n\n    function correctScrollPosition(targetElement, scroller) {\n        if (!targetElement) return;\n\n        const rect = targetElement.getBoundingClientRect();\n        const delta = rect.top - DESIRED_TOP;\n\n        if (Math.abs(delta) < 2) return;\n\n        if (scroller === window) {\n            window.scrollBy({\n                top: delta,\n                left: 0,\n                behavior: 'auto'\n            });\n        } else {\n            scroller.scrollTop += delta;\n        }\n    }\n\n    function findScrollParent(element) {\n        if (isGeminiPage()) {\n            const geminiScroller = findGeminiScrollParent(element);\n\n            if (geminiScroller) {\n                return geminiScroller === document.scrollingElement ? window : geminiScroller;\n            }\n        }\n\n        let parent = element.parentElement;\n\n        while (parent && parent !== document.body && parent !== document.documentElement) {\n            const style = window.getComputedStyle(parent);\n            const overflowY = style.overflowY;\n\n            const canScroll =\n                (overflowY === 'auto' || overflowY === 'scroll') &&\n                parent.scrollHeight > parent.clientHeight + 5;\n\n            if (canScroll) {\n                return parent;\n            }\n\n            parent = parent.parentElement;\n        }\n\n        return window;\n    }\n\n    function findGeminiScrollParent(element) {\n        let parent = element.parentElement;\n\n        while (parent && parent !== document.body && parent !== document.documentElement) {\n            const style = window.getComputedStyle(parent);\n            const overflowY = style.overflowY;\n\n            const canScroll =\n                parent.scrollHeight > parent.clientHeight + 5 &&\n                overflowY !== 'visible' &&\n                overflowY !== 'clip';\n\n            if (canScroll) {\n                return parent;\n            }\n\n            parent = parent.parentElement;\n        }\n\n        return document.scrollingElement || null;\n    }\n\n    function highlightBubble(bubbleElement) {\n        if (!bubbleElement) return;\n\n        const style = window.getComputedStyle(bubbleElement);\n        let radius = style.borderRadius || style.borderTopLeftRadius || '18px';\n\n        if (!radius || radius === '0px') {\n            radius = '18px';\n        }\n\n        bubbleElement.style.setProperty('--cgpt-highlight-radius', radius);\n        bubbleElement.classList.add('cgpt-question-bubble-highlight');\n\n        setTimeout(() => {\n            bubbleElement.classList.remove('cgpt-question-bubble-highlight');\n        }, 1800);\n    }\n\n    function detectActiveQuestion() {\n        if (!questions.length) return;\n\n        let bestIndex = -1;\n        let bestDistance = Infinity;\n        const centerY = window.innerHeight / 2;\n\n        questions.forEach((item, index) => {\n            const target = item.bubbleElement || item.scrollElement;\n            if (!target) return;\n\n            const rect = target.getBoundingClientRect();\n\n            if (rect.bottom < 0 || rect.top > window.innerHeight) return;\n\n            const mid = rect.top + rect.height / 2;\n            const dist = Math.abs(mid - centerY);\n\n            if (dist < bestDistance) {\n                bestDistance = dist;\n                bestIndex = index;\n            }\n        });\n\n        if (bestIndex !== -1 && bestIndex !== activeIndex) {\n            activeIndex = bestIndex;\n            updateActiveTick();\n        }\n    }\n\n    function updateActiveTick() {\n        const items = document.querySelectorAll(`#${ROOT_ID} .mini-item`);\n\n        items.forEach((item, index) => {\n            item.classList.toggle('active', index === activeIndex);\n        });\n    }\n\n    function updateHoverState() {\n        const items = document.querySelectorAll(`#${ROOT_ID} .mini-item`);\n\n        items.forEach((item, index) => {\n            item.classList.toggle('hovered', index === hoverIndex);\n            item.classList.toggle('move-up', hoverIndex !== -1 && index < hoverIndex);\n            item.classList.toggle('move-down', hoverIndex !== -1 && index > hoverIndex);\n        });\n    }\n\n    function showTooltip(text, itemEl) {\n        const tooltip = document.getElementById(TOOLTIP_ID);\n        if (!tooltip || !itemEl) return;\n\n        const rect = itemEl.getBoundingClientRect();\n\n        tooltip.textContent = text;\n        tooltip.style.left = (rect.left - 350) + 'px';\n        tooltip.style.top = (rect.top + rect.height / 2) + 'px';\n        tooltip.classList.add('show');\n    }\n\n    function hideTooltip() {\n        const tooltip = document.getElementById(TOOLTIP_ID);\n        if (!tooltip) return;\n\n        tooltip.classList.remove('show');\n    }\n})();\n"}