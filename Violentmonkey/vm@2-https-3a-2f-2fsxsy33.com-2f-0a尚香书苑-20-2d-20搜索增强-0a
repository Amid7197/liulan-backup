<div class=\"sxse-line\">\n    <span class=\"sxse-lab\">包含</span><input id=\"sxse-inc\" class=\"sxse-w\" type=\"text\" placeholder=\"关键词 空格分词\" title=\"空格分隔多个词；默认需要全部包含；词前加 - 表示排除，例如：斗破 完结 -预览\">\n    <span class=\"sxse-lab\">排除</span><input id=\"sxse-exc\" class=\"sxse-w\" type=\"text\" placeholder=\"排除词\" title=\"空格分隔多个词，命中任意一个就不显示\">\n    <button type=\"button\" class=\"sxse-mini\" id=\"sxse-mode\" title=\"包含词之间是「全部满足」还是「满足任一」\">全含</button>\n    <select id=\"sxse-days\" title=\"发布时间\">\n      <option value=\"0\">全部时间</option><option value=\"1\">1 天内</option><option value=\"3\">3 天内</option>\n      <option value=\"7\">7 天内</option><option value=\"30\">30 天内</option>\n    </select>\n    <select id=\"sxse-sort\" title=\"排序方式\">\n      <option value=\"default\">默认排序</option><option value=\"latest\">最新发布</option>\n      <option value=\"replies\">回复最多</option><option value=\"views\">浏览最多</option>\n      <option value=\"relevance\">相关度</option>\n    </select>\n    <select id=\"sxse-agg\" title=\"多页聚合\">\n      <option value=\"0\">聚合关闭</option><option value=\"3\">聚合 3 页</option>\n      <option value=\"5\">聚合 5 页</option><option value=\"8\">聚合 8 页</option><option value=\"10\">聚合 10 页</option>\n    </select>\n    <button type=\"button\" class=\"sxse-mini\" id=\"sxse-agg-go\">载入</button>\n  </div>\n  <div class=\"sxse-prog\" id=\"sxse-prog\"><i></i></div>\n  <div class=\"sxse-dw\" id=\"sxse-dw\">\n    <div class=\"sxse-line\">\n      <span class=\"sxse-lab\">范围</span>\n      <select id=\"sxse-scope\"><option value=\"title\">仅标题</option><option value=\"all\">标题+信息</option></select>\n      <label class=\"sxse-cb\"><input type=\"checkbox\" id=\"sxse-unread\">只看未读</label>\n      <label class=\"sxse-cb\"><input type=\"checkbox\" id=\"sxse-markread\">已读淡化</label>\n      <button type=\"button\" class=\"sxse-mini\" id=\"sxse-copy\">复制标题</button>\n      <button type=\"button\" class=\"sxse-mini\" id=\"sxse-clearread\">清空已读</button>\n      <button type=\"button\" class=\"sxse-mini\" id=\"sxse-clearhist\">清空历史</button>\n      <button type=\"button\" class=\"sxse-mini\" id=\"sxse-reset\">恢复默认</button>\n    </div>\n  </div>\n</div>`;\n    return panel;\n  }\n\n  function attachPanel(panel) {\n    const host = document.querySelector('#ct, #wp, .wp') || document.body;\n    if (host === document.body) {\n      const form = getSearchForm();\n      if (form && form.parentNode) { form.parentNode.insertBefore(panel, form.nextSibling); return; }\n    }\n    host.insertBefore(panel, host.firstChild);\n  }\n\n  function syncUI() {\n    const p = $('#sxse-panel');\n    if (!p) return;\n    const set = (sel, val) => { const el = $(sel, p); if (el && el.value !== String(val)) el.value = String(val); };\n    set('#sxse-inc', store.include);\n    set('#sxse-exc', store.exclude);\n    set('#sxse-days', store.days || 0);\n    set('#sxse-sort', store.sort || 'default');\n    set('#sxse-agg', store.aggPages || 0);\n    set('#sxse-scope', store.scope || 'title');\n    const modeBtn = $('#sxse-mode', p);\n    if (modeBtn) modeBtn.textContent = store.mode === 'any' ? '任一' : '全含';\n    const u = $('#sxse-unread', p);\n    if (u) u.checked = !!store.onlyUnread;\n    const m = $('#sxse-markread', p);\n    if (m) m.checked = !!store.markRead;\n    const fold = $('#sxse-fold', p);\n    if (fold) fold.innerHTML = p.classList.contains('folded') ? '&#9656;' : '&#9662;';\n  }\n\n  function bind(panel) {\n    const q = $('#sxse-q', panel);\n    const si = getSearchInput();\n    if (si && si.value) q.value = si.value;\n\n    const doSearch = () => submitSearch(q.value);\n    q.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doSearch(); } });\n    $('#sxse-go', panel).addEventListener('click', doSearch);\n\n    $('#sxse-fold', panel).addEventListener('click', () => {\n      panel.classList.toggle('folded');\n      store.folded = panel.classList.contains('folded');\n      saveSoon();\n      syncUI();\n    });\n\n    $('#sxse-more', panel).addEventListener('click', () => {\n      $('#sxse-dw', panel).classList.toggle('on');\n      if (panel.classList.contains('folded')) {\n        panel.classList.remove('folded');\n        store.folded = false;\n        saveSoon();\n        syncUI();\n      }\n    });\n\n    // 版块胶囊：单击 = 只看 / 取消；Ctrl、右键、长按 = 排除\n    const boards = $('#sxse-boards', panel);\n    let lpTimer = 0;\n    let lpFired = false;\n\n    boards.addEventListener('click', (e) => {\n      const chip = e.target.closest && e.target.closest('.sxse-chip');\n      if (!chip) return;\n      if (lpFired) { lpFired = false; return; }\n      e.preventDefault();\n      const fid = chip.dataset.fid || '';\n      const exc = e.ctrlKey || e.metaKey || e.altKey;\n      setBoard(fid, exc ? 'exc' : 'inc');\n    });\n    boards.addEventListener('contextmenu', (e) => {\n      const chip = e.target.closest && e.target.closest('.sxse-chip');\n      if (!chip || !chip.dataset.fid) return;\n      e.preventDefault();\n      setBoard(chip.dataset.fid, 'exc');\n    });\n    boards.addEventListener('touchstart', (e) => {\n      const chip = e.target.closest && e.target.closest('.sxse-chip');\n      if (!chip || !chip.dataset.fid) return;\n      clearTimeout(lpTimer);\n      lpFired = false;\n      lpTimer = setTimeout(() => { lpFired = true; setBoard(chip.dataset.fid, 'exc'); }, 550);\n    }, { passive: true });\n    boards.addEventListener('touchend', () => clearTimeout(lpTimer));\n    boards.addEventListener('touchmove', () => clearTimeout(lpTimer));\n\n    // 关键词输入：边输边筛\n    let tInc = 0;\n    const onWord = (el, key) => {\n      el.addEventListener('input', () => {\n        store[key] = el.value;\n        saveSoon();\n        clearTimeout(tInc);\n        tInc = setTimeout(refresh, 220);\n      });\n    };\n    onWord($('#sxse-inc', panel), 'include');\n    onWord($('#sxse-exc', panel), 'exclude');\n\n    $('#sxse-mode', panel).addEventListener('click', () => {\n      store.mode = store.mode === 'any' ? 'all' : 'any';\n      saveSoon();\n      syncUI();\n      refresh();\n    });\n\n    $('#sxse-days', panel).addEventListener('change', (e) => {\n      store.days = Number(e.target.value) || 0;\n      saveSoon();\n      refresh();\n    });\n\n    $('#sxse-sort', panel).addEventListener('change', (e) => {\n      store.sort = e.target.value || 'default';\n      saveSoon();\n      collectBoards(false);   // 排序会移动节点，先保住顺序标记\n      applySort();\n      refresh();\n    });\n\n    $('#sxse-agg', panel).addEventListener('change', (e) => {\n      store.aggPages = Number(e.target.value) || 0;\n      saveSoon();\n    });\n\n    $('#sxse-agg-go', panel).addEventListener('click', () => {\n      if (aggRunning) { aggStop = true; return; }\n      const pages = Number(store.aggPages) || 0;\n      if (!pages) { setStat('请先选择聚合页数'); $('#sxse-agg', panel).focus(); return; }\n      runAggregate(Math.min(10, Math.max(1, pages)));\n    });\n\n    $('#sxse-scope', panel).addEventListener('change', (e) => {\n      store.scope = e.target.value === 'all' ? 'all' : 'title';\n      saveSoon();\n      refresh();\n    });\n    $('#sxse-unread', panel).addEventListener('change', (e) => {\n      store.onlyUnread = e.target.checked;\n      saveSoon();\n      refresh();\n    });\n    $('#sxse-markread', panel).addEventListener('change', (e) => {\n      store.markRead = e.target.checked;\n      saveSoon();\n      refresh();\n    });\n\n    $('#sxse-copy', panel).addEventListener('click', async () => {\n      const list = getItems().filter((it) => !it.classList.contains('sxse-hide')).map((it) => getTitle(it)).filter(Boolean);\n      if (!list.length) { setStat('没有可见结果'); return; }\n      const str = list.join('\\n');\n      try {\n        await navigator.clipboard.writeText(str);\n        setStat(`已复制 ${list.length} 条标题`);\n      } catch (e) {\n        const ta = document.createElement('textarea');\n        ta.value = str;\n        ta.style.cssText = 'position:fixed;top:-999px';\n        document.body.appendChild(ta);\n        ta.select();\n        try { document.execCommand('copy'); setStat(`已复制 ${list.length} 条标题`); } catch (e2) { setStat('复制失败'); }\n        ta.remove();\n      }\n    });\n\n    $('#sxse-clearread', panel).addEventListener('click', () => {\n      store.visited = {};\n      save();\n      refresh();\n      setStat('已清空已读记录');\n    });\n    $('#sxse-clearhist', panel).addEventListener('click', () => {\n      store.history = [];\n      save();\n      renderHistory();\n      setStat('已清空搜索历史');\n    });\n    $('#sxse-reset', panel).addEventListener('click', () => {\n      store.include = '';\n      store.exclude = '';\n      store.mode = 'all';\n      store.scope = 'title';\n      store.incFids = [];\n      store.excFids = [];\n      store.days = 0;\n      store.sort = 'default';\n      store.onlyUnread = false;\n      store.markRead = true;\n      save();\n      syncUI();\n      applySort();\n      refresh();\n      lastBoardSig = '';\n      setStat('已恢复默认');\n    });\n\n    renderHistory();\n    syncUI();\n  }\n\n  /* ------------------------------ 已读标记 ------------------------------ */\n\n  function pruneVisited() {\n    const keys = Object.keys(store.visited);\n    if (keys.length <= 1500) return;\n    keys.sort((a, b) => store.visited[a] - store.visited[b])\n      .slice(0, keys.length - 1500)\n      .forEach((k) => { delete store.visited[k]; });\n  }\n\n  function onItemClick(e) {\n    if (!store.markRead) return;\n    const t = e.target;\n    const a = t && t.closest ? t.closest('a') : null;\n    if (!a) return;\n    const item = a.closest('li.pbw, tbody[id^=\"normalthread_\"], .pbw');\n    if (!item) return;\n    const tid = getTid(item);\n    if (!tid) return;\n    store.visited[tid] = Date.now();\n    pruneVisited();\n    saveSoon();\n    item.classList.add('sxse-read');\n  }\n\n  /* -------------------------------- 初始化 ------------------------------ */\n\n  function init() {\n    if ($('#sxse-panel')) return;\n\n    const hasList = !!document.querySelector('#threadlist, #threadlisttableid, .slst');\n    // 只在「搜索页」或「帖子列表页」出现，避免在帖子内容页占地方\n    if (!isSearchPage && !hasList) return;\n\n    injectStyle();\n    const panel = buildPanel();\n    attachPanel(panel);\n    bind(panel);\n    applyTheme();\n    collectBoards(true);\n\n    const items = getItems();\n    items.forEach((it, idx) => { it.dataset.sxOrd = String(idx); });\n\n    applySort();\n    refresh();\n\n    // 站点样式表可能晚于本脚本加载，稍后再校准一次配色\n    setTimeout(applyTheme, 600);\n    window.addEventListener('load', () => setTimeout(applyTheme, 100));\n\n    document.addEventListener('click', onItemClick, true);\n    document.addEventListener('auxclick', onItemClick, true);\n\n    // 论坛会异步插入帖子列表，这里节流后再刷新，并避免自己改动 DOM 引起的死循环\n    const root = document.querySelector('#threadlist, #threadlisttableid, .slst, #ct') || document.body;\n    const obs = new MutationObserver(() => {\n      if (applying) return;\n      clearTimeout(obsTimer);\n      obsTimer = setTimeout(() => {\n        if (aggRunning) return;\n        refresh();\n      }, 180);\n    });\n    try { obs.observe(root, { childList: true, subtree: true }); } catch (e) {}\n\n    // 快捷键：/ 或 Alt+S 聚焦搜索框\n    document.addEventListener('keydown', (e) => {\n      if (e.key === '/' || (e.altKey && (e.key === 's' || e.key === 'S'))) {\n        const tag = (e.target && e.target.tagName) || '';\n        if (/^(INPUT|TEXTAREA|SELECT)$/.test(tag)) return;\n        e.preventDefault();\n        if (panel.classList.contains('folded')) {\n          panel.classList.remove('folded');\n          store.folded = false;\n          saveSoon();\n          syncUI();\n        }\n        const box = $('#sxse-q');\n        if (box) { box.focus(); box.select(); }\n      }\n    }, true);\n  }\n\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });\n  else init();\n})();\n"}