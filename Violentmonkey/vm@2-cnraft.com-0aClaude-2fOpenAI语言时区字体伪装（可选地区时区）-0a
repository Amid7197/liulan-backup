{"version":2,"custom":{"origInclude":true,"origExclude":true,"origMatch":true,"origExcludeMatch":true,"origTag":true,"pathMap":{}},"config":{"enabled":1,"shouldUpdate":1,"httpOnly":0,"removed":0},"props":{"lastUpdated":1794810601468},"code":"// ==UserScript==\n// @name         Claude/OpenAI语言时区字体伪装（可选地区时区）\n// @namespace    cnraft.com\n// @version      1.4.0\n// @description  Claude/OpenAI 环境伪装：英语语言、可选地区时区、UA 与中文字体检测拦截\n// @author       Mrcool\n// @match        *://claude.ai/*\n// @match        *://*.claude.ai/*\n// @match        *://chatgpt.com/*\n// @match        *://*.chatgpt.com/*\n// @match        *://chat.openai.com/*\n// @match        *://openai.com/*\n// @match        *://*.openai.com/*\n// @match        *://browseris.com/*\n// @match        *://passer-by.com/*\n// @match        *://ippure.com/*\n// @match        *://ipsuper.com/*\n// @match        *://*.999cq.icu/*\n// @match        *://999cq.icu/*\n// @match        *://ip.net.coffee/claude*\n// @match        *://*.net.coffee/claude*\n// @run-at       document-start\n// @grant        GM_getValue\n// @grant        GM_setValue\n// @grant        unsafeWindow\n// @license MIT\n// ==/UserScript==\n\n(function () {\n  'use strict';\n\n  // ===== 页面上下文与可配置项 =====\n  // 本脚本需要修改页面实际读取的 Intl / Date / navigator，因此明确对主页面上下文打补丁。\n  const W = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;\n  const D = W.document;\n  const STORAGE_KEY = 'claude-openai-spoof-timezone';\n  const DEFAULT_TZ = 'America/Los_Angeles';\n  const TIMEZONE_OPTIONS = [\n    { label: '新加坡', value: 'Asia/Singapore' },\n    { label: '美国 · 洛杉矶（太平洋）', value: 'America/Los_Angeles' },\n    { label: '美国 · 丹佛（山地）', value: 'America/Denver' },\n    { label: '美国 · 芝加哥（中部）', value: 'America/Chicago' },\n    { label: '美国 · 纽约（东部）', value: 'America/New_York' },\n    { label: '美国 · 安克雷奇', value: 'America/Anchorage' },\n    { label: '美国 · 檀香山', value: 'Pacific/Honolulu' },\n    { label: '日本', value: 'Asia/Tokyo' },\n    { label: '韩国', value: 'Asia/Seoul' },\n    { label: '香港', value: 'Asia/Hong_Kong' },\n    { label: '台湾', value: 'Asia/Taipei' },\n    { label: '英国', value: 'Europe/London' },\n    { label: '德国', value: 'Europe/Berlin' },\n    { label: '法国', value: 'Europe/Paris' },\n    { label: '澳大利亚 · 悉尼', value: 'Australia/Sydney' },\n    { label: '加拿大 · 温哥华', value: 'America/Vancouver' },\n    { label: '加拿大 · 多伦多', value: 'America/Toronto' },\n    { label: '协调世界时 UTC', value: 'Etc/UTC' }\n  ];\n\n  function isValidTimezone(value) {\n    return TIMEZONE_OPTIONS.some(item => item.value === value);\n  }\n\n  // GM_getValue / GM_setValue 让所选时区在不同网站之间共用；无 GM API 时退回本站 localStorage。\n  function readTimezone() {\n    try {\n      if (typeof GM_getValue === 'function') {\n        const value = GM_getValue(STORAGE_KEY, DEFAULT_TZ);\n        if (typeof value === 'string' && isValidTimezone(value)) return value;\n      }\n    } catch (e) {}\n    try {\n      const value = W.localStorage.getItem(STORAGE_KEY);\n      if (value && isValidTimezone(value)) return value;\n    } catch (e) {}\n    return DEFAULT_TZ;\n  }\n\n  function saveTimezone(value) {\n    try {\n      if (typeof GM_setValue === 'function') return GM_setValue(STORAGE_KEY, value);\n    } catch (e) {}\n    try { W.localStorage.setItem(STORAGE_KEY, value); } catch (e) {}\n    return undefined;\n  }\n\n  let TZ = readTimezone();\n  const LOC = 'en-US';               // 伪装语言 / locale（保持英语）\n  const LANG_LIST = ['en-US', 'en']; // navigator.languages\n  const DEBUG = false;               // 改为 true 会在 console 打印被覆盖后的取值，用于自查\n\n  // 常见中文/东亚字体名（用于拦截字体探测 + 排除显示）\n  // —— 标准中文/东亚系统字体（ippure.com/claude 的 27 个检测项）：\n  //   简体: Microsoft YaHei / YaHei UI, SimSun, NSimSun, SimHei, KaiTi, FangSong,\n  //         DengXian, PingFang SC, Hiragino Sans GB, STHeiti, STSong, Songti SC,\n  //         Source Han Sans CN/SC, Noto Sans/Serif CJK SC, WenQuanYi Micro/Zen Hei\n  //   繁体: Microsoft JhengHei, PMingLiU, MingLiU, DFKai-SB, PingFang TC/HK,\n  //         Source Han Sans TW, Noto Sans CJK TC\n  // —— 厂商专属字体（ipsuper.com/claude “厂商专属字体”项，逆向自混淆 JS，RC4 字符串表还原）：\n  //   小米 MiSans；华为 HarmonyOS Sans(/SC)；荣耀 HONOR Sans；OPPO OPPO Sans；vivo vivo Sans；\n  //   汉仪 HYQiHei / HuiTi / inBuTi；方正 FZShuSong / FZFangSong / FZHei(B01S 等，FZ 前缀)；\n  //   阿里巴巴 Alibaba PuHuiTi(/Sans)；字节/抖音 Douyin Sans；realme / Meizu 等国产厂商字体。\n  //   这些字体在桌面 PC/Mac 上默认不安装，但列入正则可保证“即便设备装了也判未安装”，并防未来站点扩列。\n  // —— passer-by.com/browser 的“支持字体”列表（逆向自 index.js 的 fontList，共 79 项，全部英文 key）：\n  //   Windows: PMingLiU/MingLiU/DFKai-SB/SimHei/SimSun/NSimSun/FangSong/KaiTi/KaiTi_GB2312/\n  //            FangSong_GB2312/Microsoft YaHei/Microsoft JhengHei/STXihei/STHeiti/STKaiti/\n  //            STSong/STFangsong/STZhongsong/STCaiyun/STHupo/STLiti/STXingkai/STXinwei/\n  //            LiSu/YouYuan/FZShuTi/FZYaoti\n  //   Mac:     BiauKai/LiHei Pro Medium/LiSong Pro Light/Apple LiGothic Medium/Apple LiSung Light/\n  //            PingFang SC/TC/HK/Xingkai SC/Weibei SC/Yuanti SC/Songti SC/Lantinghei SC/\n  //            Hanzipen SC/Wawati SC/Yapi SC/Hiragino Sans GB\n  //   开源/国产: Source Han Sans/Serif/Mono CN/Gen Shin Gothic/LXGW WenKai/HarmonyOS Sans/\n  //            Alibaba PuHuiTi 2.0/3.0/Alimama 系列/Douyin Sans/OPPO Sans\n  //   （日韩: Meiryo / MS Gothic / MS Mincho / Malgun / Apple SD Gothic / Yu Gothic / Batang / Dotum 亦列入）\n  // v1.3.0：收紧过宽前缀 + 给拉丁/厂商名单加 \\b 词边界\n  //   - ST[A-Za-z]+     → ST(Xihei|Heiti|Kaiti|Song|Fangsong|Zhongsong|Caiyun|Hupo|Liti|Xingkai|Xinwei|Yuanti|Libian)\n  //   - Song（裸词）     → 删除（Songti / STSong 已单独覆盖）\n  //   - vivo            → vivo\\s*Sans\n  //   - 全量补 \\b，避免 \"Avivo Sans\" 这类被 \\bvivo\\s*Sans 命中\n  const CJK_FONT_RE = /(?:PingFang|YaHei|JhengHei|\\bMicrosoft|SimSun|NSimSun|SimHei|KaiTi|DFKai|FangSong|DengXian|Hiragino|\\bST(?:Xihei|Heiti|Kaiti|Song|Fangsong|Zhongsong|Caiyun|Hupo|Liti|Xingkai|Xinwei|Yuanti|Libian)|\\bSongti|\\bHeiti|Lantinghei|Hanzipen|Wawati|\\bYapi|\\bYuanti|Xingkai|Weibei|BiauKai|LiHei|LiSong|Apple\\s*Li|Source\\s*Han|Noto\\s+[A-Za-z]+\\s+CJK|WenQuanYi|MingLiU|Meiryo|\\bMS\\s*Gothic|\\bMS\\s*Mincho|Malgun|Apple\\s*SD\\s*Gothic|Yu\\s*Gothic|Batang|Dotum|\\bMiSans|\\bMIUI|\\bHarmonyOS|\\bHONOR\\s*Sans|\\bOPPO\\s*Sans|\\bvivo\\s*Sans|\\bHYQiHei|\\bHuiTi|\\bJinBuTi|\\bFZ[A-Za-z]+|\\bAlibaba|\\bAlimama|\\bDouyin|\\bLXGW|\\bWenKai|\\bGen\\s*Shin|\\brealme|\\bMeizu|\\bLiSu|\\bYouYuan)/i;\n\n  // ===== 1. 计算所选 IANA 时区在指定日期的偏移（分钟）=====\n  // 不写死 UTC 偏移；夏令时地区会按具体日期自动得到正确偏移。\n  const REAL_DTF = W.Intl.DateTimeFormat;\n  function timezoneOffsetMinutes(date) {\n    const dtf = new REAL_DTF('en-US', {\n      timeZone: TZ, hourCycle: 'h23',\n      year: 'numeric', month: '2-digit', day: '2-digit',\n      hour: '2-digit', minute: '2-digit', second: '2-digit'\n    });\n    const parts = {};\n    for (const p of dtf.formatToParts(date)) parts[p.type] = p.value;\n    let hour = parseInt(parts.hour, 10);\n    if (hour === 24) hour = 0;\n    const asUTC = Date.UTC(\n      +parts.year, +parts.month - 1, +parts.day,\n      hour, +parts.minute, +parts.second\n    );\n    // getTimezoneOffset() = UTC - 本地时间；例如新加坡 UTC+8 返回 -480。\n    return Math.round((date.getTime() - asUTC) / 60000);\n  }\n\n  // ===== 2. Intl 默认 locale / timeZone 注入 =====\n  function WrappedDTF(locales, options) {\n    const opts = options ? Object.assign({}, options) : {};\n    if (!opts.timeZone) opts.timeZone = TZ;\n    return new REAL_DTF(locales || LOC, opts);\n  }\n  WrappedDTF.prototype = REAL_DTF.prototype;\n  WrappedDTF.supportedLocalesOf = REAL_DTF.supportedLocalesOf;\n  W.Intl.DateTimeFormat = WrappedDTF;\n\n  // NumberFormat / Collator / PluralRules / ListFormat / RelativeTimeFormat 默认 locale\n  ['NumberFormat', 'Collator', 'PluralRules', 'ListFormat', 'RelativeTimeFormat'].forEach(function (key) {\n    const Real = W.Intl[key];\n    function Wrapped(locales, options) {\n      return new Real(locales || LOC, options);\n    }\n    Wrapped.prototype = Real.prototype;\n    Wrapped.supportedLocalesOf = Real.supportedLocalesOf;\n    W.Intl[key] = Wrapped;\n  });\n\n  // resolvedOptions 兜底：默认格式化器返回所选时区与英语 locale。\n  const realResolved = REAL_DTF.prototype.resolvedOptions;\n  REAL_DTF.prototype.resolvedOptions = function () {\n    const opts = realResolved.call(this);\n    opts.locale = LOC;\n    return opts;\n  };\n\n  // ===== 3. Date.prototype.getTimezoneOffset -> 所选时区偏移 =====\n  W.Date.prototype.getTimezoneOffset = function () {\n    return timezoneOffsetMinutes(this);\n  };\n\n  // ===== 4. navigator.language / languages =====\n  try {\n    Object.defineProperty(W.navigator, 'language',  { get: () => LOC, configurable: true });\n    Object.defineProperty(W.navigator, 'languages', { get: () => LANG_LIST.slice(), configurable: true });\n  } catch (e) { /* 部分环境 navigator 被冻结，忽略 */ }\n\n  // ===== 4b. 伪装 UA / platform（尽量保留真实浏览器版本号）=====\n  const SPOOF_UA = true;\n  const REAL_UA = W.navigator.userAgent || '';\n  const FAKE_UA = REAL_UA.replace(/\\([^)]*\\)/, '(Macintosh; Intel Mac OS X 10_15_7)');\n  if (SPOOF_UA) {\n    try { Object.defineProperty(W.navigator, 'userAgent', { get: () => FAKE_UA, configurable: true }); } catch (e) {}\n    try { Object.defineProperty(W.navigator, 'platform',  { get: () => 'MacIntel', configurable: true }); } catch (e) {}\n    try { Object.defineProperty(W.navigator, 'vendor',    { get: () => 'Google Inc.', configurable: true }); } catch (e) {}\n    try {\n      const NP = W.Navigator && W.Navigator.prototype;\n      if (NP) {\n        Object.defineProperty(NP, 'userAgent', { get: () => FAKE_UA, configurable: true });\n        Object.defineProperty(NP, 'platform',  { get: () => 'MacIntel', configurable: true });\n        Object.defineProperty(NP, 'vendor',    { get: () => 'Google Inc.', configurable: true });\n      }\n    } catch (e) {}\n\n    // Chromium 新版还提供 UA Client Hints；尽量让其平台字段与 Mac UA 保持一致。\n    try {\n      const realUAData = W.navigator.userAgentData;\n      if (realUAData) {\n        const fakeUAData = {\n          brands: realUAData.brands,\n          mobile: false,\n          platform: 'macOS',\n          async getHighEntropyValues(hints) {\n            const data = await realUAData.getHighEntropyValues(hints);\n            return Object.assign({}, data, {\n              mobile: false,\n              platform: 'macOS',\n              platformVersion: '10.15.7',\n              model: ''\n            });\n          },\n          toJSON() {\n            return Object.assign({}, realUAData.toJSON(), { mobile: false, platform: 'macOS' });\n          }\n        };\n        Object.defineProperty(W.navigator, 'userAgentData', { get: () => fakeUAData, configurable: true });\n      }\n    } catch (e) {}\n  }\n\n  // ===== 5. 字体探测拦截（让站点以为系统没装中文/东亚字体）=====\n  // 依据开源库 mumuy/browser（passer-by.com / browseris.com 同源）的 support/font-family.js：\n  //   站点用 canvas 像素对比法 —— 先以 `100px 'Arial', Arial` 渲染“永”取像素作基线，\n  //   再以 `100px '待测字体', Arial` 渲染同字取像素，两者像素不同 => 判定“已安装”。\n  //   由于 Arial 不含“永”字形，基线实际回落到系统默认中文字体（如 SimSun）；只要让待测\n  //   字体也回落到同一系统字体，两次像素必然一致 => 判“未安装”。\n  //   统一靠 stripCJKFont() 在“字体串落地前”把中文/东亚字体名剔除，多管齐下：\n  //     5a. 覆写 ctx.font 的 setter（主防御，覆盖 measureText/fillText/strokeText/getImageData 全部路径）\n  //     5b. measureText 兜底（ippure / ipsuper 的宽度法）\n  //     5c. fillText / strokeText 兜底（同上像素法，双保险）\n  //     5d. document.fonts.check 对 CJK 字体一律 false\n  //\n  //   v1.1.0 修复（2026-10-25）：旧实现只剥单引号 `'X'`，且无引号分支被 (^|,\\s*) 锚点卡死，\n  //   对站点最常用的 `72px \"Microsoft YaHei\", monospace` 完全失效（999cq.icu 实测全中）。\n  //   现改为：先切出 font shorthand 前缀（style/weight/size[/line-height]），只对家族列表\n  //   按逗号拆分、用 CJK_FONT_RE 逐 token 判定（带不带引号都命中），再丢包重拼。\n  function stripCJKFont(fontStr) {\n    if (typeof fontStr !== 'string' || !CJK_FONT_RE.test(fontStr)) return fontStr;\n    // 切出 \"…  72px[/24px] \" 之前的前缀，剩余部分才是字体家族列表\n    const m = fontStr.match(/^([\\s\\S]*?(?:\\d+(?:\\.\\d+)?(?:px|pt|pc|em|rem|%|ex|ch|vh|vw|vmin|vmax|cm|mm|in|q)|(?:xx?-)?(?:small|larger?|medium))\\s*(?:\\/\\s*\\S+\\s*)?)([\\s\\S]*)$/i);\n    const prefix = m ? m[1] : '';\n    const parts  = (m ? m[2] : fontStr).split(',');\n    const total  = parts.filter(function (p) { return p.trim().length > 0; }).length;\n    const kept   = parts.map(function (p) { return p.trim(); })\n                        .filter(function (p) { return p.length > 0 && !CJK_FONT_RE.test(p); });\n    if (kept.length === total) return fontStr; // 无可剥离项，原样返回，避免破坏合法字体串\n    return prefix + (kept.length ? kept.join(', ') : 'sans-serif');\n  }\n\n  // 5a. 主防御：覆写 ctx.font 的 setter（覆盖所有 canvas 字体读取路径）\n  try {\n    const protos = [W.CanvasRenderingContext2D.prototype];\n    if (typeof W.OffscreenCanvasRenderingContext2D !== 'undefined')\n      protos.push(W.OffscreenCanvasRenderingContext2D.prototype);\n    protos.forEach(function (proto) {\n      const desc = Object.getOwnPropertyDescriptor(proto, 'font');\n      if (!desc || !desc.set) return;\n      Object.defineProperty(proto, 'font', {\n        configurable: true,\n        enumerable: true,\n        get: function () { return desc.get.call(this); },\n        set: function (v) {\n          if (typeof v === 'string') v = stripCJKFont(v);\n          desc.set.call(this, v);\n        }\n      });\n    });\n  } catch (e) { /* 个别环境 font 不可重定义，靠 5b/5c 兜底 */ }\n\n  // 5b/c. 方法级兜底（防止 setter 重定义失败时有遗漏）\n  try {\n    const CtxProto = W.CanvasRenderingContext2D.prototype;\n    const realMeasure = CtxProto.measureText;\n    CtxProto.measureText = function (text) {\n      if (this.font && CJK_FONT_RE.test(this.font)) this.font = stripCJKFont(this.font);\n      return realMeasure.call(this, text);\n    };\n  } catch (e) {}\n  try {\n    const CtxProto = W.CanvasRenderingContext2D.prototype;\n    const realFillText = CtxProto.fillText;\n    const realStrokeText = CtxProto.strokeText;\n    CtxProto.fillText = function (text, x, y, maxWidth) {\n      if (this.font && CJK_FONT_RE.test(this.font)) this.font = stripCJKFont(this.font);\n      return realFillText.call(this, text, x, y, maxWidth);\n    };\n    CtxProto.strokeText = function (text, x, y, maxWidth) {\n      if (this.font && CJK_FONT_RE.test(this.font)) this.font = stripCJKFont(this.font);\n      return realStrokeText.call(this, text, x, y, maxWidth);\n    };\n  } catch (e) {}\n\n  // 5d. document.fonts.check：对 CJK 字体一律 false\n  try {\n    const realCheck = D.fonts.check.bind(D.fonts);\n    D.fonts.check = function (font, text) {\n      if (font && CJK_FONT_RE.test(font)) return false;\n      return realCheck(font, text);\n    };\n  } catch (e) {}\n\n  // ===== 6. 注入 CSS：只让\"继承型\"文本回落到纯拉丁字体栈 =====\n  // v1.3.0 修复：旧版把 `div, span, p, a, i …` 全量 font-family 压成拉丁栈并加 !important，\n  //   会把站点自带 font-family 的图标元素（图标字体 / PUA 私有区字形）一并压掉，图标变成\n  //   豆腐块（claude.ai 侧栏 / 输入框图标即此例，Windows 下显示为框内十六进制 .notdef）。\n  //   旧版\"豁免规则\"写的是 font-family: inherit !important —— 继承到的仍是被压掉的拉丁栈，\n  //   等于没豁免。\n  //   现改为：只压 body。子元素只要自带 font-family（图标字体、品牌字体、代码块）就按站点\n  //   原样生效（元素自身声明永远优先于继承值，与 !important 无关）；表单控件用 inherit 跟随\n  //   body，站点自定义规则优先级更高时仍以站点为准；不再动 button，避免图标按钮被牵连。\n  function injectFontCSS() {\n    const style = D.createElement('style');\n    style.id = 'us-en-font-spoof';\n    style.textContent = `\n      html body, body {\n        font-family: \"Helvetica Neue\", Helvetica, Arial, \"Segoe UI\", Roboto, \"Liberation Sans\", sans-serif !important;\n      }\n      input, textarea, select {\n        font-family: inherit;\n      }\n      code, pre, kbd, samp {\n        font-family: \"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace;\n      }\n    `;\n    (D.head || D.documentElement).appendChild(style);\n  }\n  if (D.documentElement) injectFontCSS();\n  else D.addEventListener('readystatechange', function () {\n    if (D.documentElement && !D.getElementById('us-en-font-spoof')) injectFontCSS();\n  });\n\n  // ===== 7. Net.Coffee Claude 检测页时区选择面板 =====\n  // 仅在 ip.net.coffee/claude 页面显示；保存走 GM 存储，因此 Claude/OpenAI 等站点也会共用选择。\n  function mountTimezonePanel() {\n    if (W.location.hostname !== 'ip.net.coffee' || !/^\\/claude(?:\\/|$)/.test(W.location.pathname)) return;\n    if (D.getElementById('timezone-spoof-panel-host')) return;\n\n    const host = D.createElement('div');\n    host.id = 'timezone-spoof-panel-host';\n    const shadow = host.attachShadow ? host.attachShadow({ mode: 'open' }) : host;\n    shadow.innerHTML = `\n      <style>\n        :host { all: initial; }\n        .toggle {\n          position: fixed; right: 18px; bottom: 18px; z-index: 2147483647;\n          border: 1px solid #64748b; border-radius: 999px; padding: 10px 14px;\n          background: #111827; color: #fff; font: 13px/1.2 system-ui, sans-serif;\n          box-shadow: 0 4px 18px rgba(0,0,0,.25); cursor: pointer;\n        }\n        .panel {\n          position: fixed; right: 18px; bottom: 66px; z-index: 2147483647;\n          width: min(320px, calc(100vw - 36px)); box-sizing: border-box;\n          padding: 15px; border: 1px solid #475569; border-radius: 12px;\n          background: #111827; color: #f8fafc; box-shadow: 0 8px 28px rgba(0,0,0,.32);\n          font: 13px/1.5 system-ui, sans-serif;\n        }\n        .panel[hidden] { display: none; }\n        .title { margin: 0 0 8px; font-size: 14px; font-weight: 700; }\n        .desc { margin: 0 0 10px; color: #cbd5e1; }\n        select {\n          display: block; width: 100%; box-sizing: border-box; margin: 0 0 8px;\n          padding: 9px 10px; border: 1px solid #64748b; border-radius: 7px;\n          background: #fff; color: #111827; font: inherit;\n        }\n        .zone { margin: 0 0 12px; color: #cbd5e1; overflow-wrap: anywhere; }\n        .save {\n          width: 100%; padding: 9px 12px; border: 0; border-radius: 7px;\n          background: #2563eb; color: #fff; font: 600 13px system-ui, sans-serif; cursor: pointer;\n        }\n        .note { margin: 9px 0 0; color: #94a3b8; font-size: 11px; }\n      </style>\n      <button class=\"toggle\" type=\"button\" aria-expanded=\"false\">🕒 时区设置</button>\n      <section class=\"panel\" hidden>\n        <p class=\"title\">选择伪装地区 / 时区</p>\n        <p class=\"desc\">选择后会保存为全站共用设置，并刷新当前检测页。</p>\n        <select aria-label=\"伪装时区\"></select>\n        <p class=\"zone\"></p>\n        <button class=\"save\" type=\"button\">保存并刷新检测</button>\n        <p class=\"note\">语言仍固定为 en-US；美国不同地区使用各自的夏令时规则。</p>\n      </section>\n    `;\n\n    const toggle = shadow.querySelector('.toggle');\n    const panel = shadow.querySelector('.panel');\n    const select = shadow.querySelector('select');\n    const zone = shadow.querySelector('.zone');\n    const save = shadow.querySelector('.save');\n\n    TIMEZONE_OPTIONS.forEach(item => {\n      const option = D.createElement('option');\n      option.value = item.value;\n      option.textContent = `${item.label} — ${item.value}`;\n      select.appendChild(option);\n    });\n    select.value = TZ;\n    zone.textContent = `当前时区值：${TZ}`;\n    select.addEventListener('change', () => {\n      zone.textContent = `将使用时区值：${select.value}`;\n    });\n    toggle.addEventListener('click', () => {\n      panel.hidden = !panel.hidden;\n      toggle.setAttribute('aria-expanded', String(!panel.hidden));\n    });\n    save.addEventListener('click', () => {\n      const value = select.value;\n      if (!isValidTimezone(value)) return;\n      save.disabled = true;\n      save.textContent = '已保存，正在刷新…';\n      const result = saveTimezone(value);\n      if (result && typeof result.then === 'function') {\n        result.then(() => W.location.reload(), () => W.location.reload());\n      } else {\n        W.location.reload();\n      }\n    });\n\n    (D.body || D.documentElement).appendChild(host);\n  }\n\n  if (W.location.hostname === 'ip.net.coffee' && /^\\/claude(?:\\/|$)/.test(W.location.pathname)) {\n    if (D.readyState === 'loading') D.addEventListener('DOMContentLoaded', mountTimezonePanel, { once: true });\n    else mountTimezonePanel();\n  }\n\n  // ===== 自查日志 =====\n  if (DEBUG) {\n    const d = new W.Date();\n    W.console.log('[spoof] language =', W.navigator.language, W.navigator.languages);\n    W.console.log('[spoof] Intl tz  =', W.Intl.DateTimeFormat().resolvedOptions().timeZone);\n    W.console.log('[spoof] tzOffset =', d.getTimezoneOffset(), 'min (', (d.getTimezoneOffset()/60), 'h )');\n    W.console.log('[spoof] locale   =', W.Intl.NumberFormat().resolvedOptions().locale);\n  }\n})();\n"}