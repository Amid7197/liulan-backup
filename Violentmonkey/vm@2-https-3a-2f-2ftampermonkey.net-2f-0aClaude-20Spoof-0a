{"version":2,"custom":{"origInclude":true,"origExclude":true,"origMatch":true,"origExcludeMatch":true,"origTag":true,"from":"https://greasyfork.org/zh-CN/scripts/599127-claude-spoof","lastInstallURL":"https://update.greasyfork.org/scripts/599127/Claude%20Spoof.user.js","pathMap":{}},"config":{"enabled":0,"removed":0,"shouldUpdate":1},"props":{"lastUpdated":1794640058875},"code":"// ==UserScript==\n// @name         Claude Spoof\n// @namespace    https://tampermonkey.net/\n// @version      1.0\n// @description  伪装特定网站的时区、语言和 Intl API 参数\n// @author       You\n// @match        *://*.fuck-claude.com/*\n// @match        *://*.cleanip.io/*\n// @match        *://*.anthropic.com/*\n// @match        *://*.claude.com/*\n// @match        *://*.claude.ai/*\n// @run-at       document-start\n// @grant        none\n// @allFrames    true\n// @downloadURL https://update.greasyfork.org/scripts/599127/Claude%20Spoof.user.js\n// @updateURL https://update.greasyfork.org/scripts/599127/Claude%20Spoof.meta.js\n// ==/UserScript==\n\n(function() {\n    'use strict';\n\n    // ==================== 自定义伪装配置 ====================\n    const CONFIG = {\n        // 伪装语言\n        language: 'en-US',\n        languages: ['en-US'],\n        \n        // 伪装时区 (IANA 时区名)\n        timeZone: 'Asia/Singapore',\n        // 时区偏移分钟数 (UTC - 本地时间)。例如：\n        // UTC-5 (EST) 为 +300，UTC-4 (EDT 夏令时) 为 +240，UTC+8 为 -480\n        timezoneOffsetMinutes: 0\n    };\n    // =======================================================\n\n    // 1. 伪装 navigator 语言参数\n    const spoofNavigator = (prop, value) => {\n        try {\n            Object.defineProperty(navigator, prop, {\n                get: () => value,\n                configurable: true,\n                enumerable: true\n            });\n        } catch (e) {\n            console.warn(`[Spoofer] Failed to spoof navigator.${prop}`, e);\n        }\n    };\n\n    spoofNavigator('language', CONFIG.language);\n    spoofNavigator('languages', Object.freeze([...CONFIG.languages]));\n\n    // 2. 伪装 Intl.DateTimeFormat\n    const OriginalDateTimeFormat = Intl.DateTimeFormat;\n\n    function SpoofedDateTimeFormat(locales, options = {}) {\n        const mergedOptions = {\n            ...options,\n            timeZone: options.timeZone || CONFIG.timeZone\n        };\n        const targetLocale = locales || CONFIG.language;\n        return new OriginalDateTimeFormat(targetLocale, mergedOptions);\n    }\n\n    SpoofedDateTimeFormat.prototype = OriginalDateTimeFormat.prototype;\n    SpoofedDateTimeFormat.supportedLocalesOf = OriginalDateTimeFormat.supportedLocalesOf.bind(OriginalDateTimeFormat);\n\n    // 拦截 resolvedOptions\n    const originalResolvedOptions = OriginalDateTimeFormat.prototype.resolvedOptions;\n    OriginalDateTimeFormat.prototype.resolvedOptions = function() {\n        const options = originalResolvedOptions.call(this);\n        options.timeZone = options.timeZone || CONFIG.timeZone;\n        if (!options.locale || options.locale.startsWith('default')) {\n            options.locale = CONFIG.language;\n        }\n        return options;\n    };\n\n    window.Intl.DateTimeFormat = SpoofedDateTimeFormat;\n\n    // 3. 拦截其它 Intl 构造函数的默认 locale\n    ['NumberFormat', 'Collator', 'PluralRules', 'RelativeTimeFormat'].forEach(api => {\n        if (Intl[api]) {\n            const OriginalAPI = Intl[api];\n            function SpoofedAPI(locales, options) {\n                return new OriginalAPI(locales || CONFIG.language, options);\n            }\n            SpoofedAPI.prototype = OriginalAPI.prototype;\n            if (OriginalAPI.supportedLocalesOf) {\n                SpoofedAPI.supportedLocalesOf = OriginalAPI.supportedLocalesOf.bind(OriginalAPI);\n            }\n            window.Intl[api] = SpoofedAPI;\n        }\n    });\n\n    // 4. 伪装 Date.prototype.getTimezoneOffset\n    Date.prototype.getTimezoneOffset = function() {\n        return CONFIG.timezoneOffsetMinutes;\n    };\n\n    // 5. 伪装 Date 格式化输出 (toString, toLocaleString 等)\n    const originalToString = Date.prototype.toString;\n    Date.prototype.toString = function() {\n        return new OriginalDateTimeFormat(CONFIG.language, {\n            timeZone: CONFIG.timeZone,\n            weekday: 'short',\n            year: 'numeric',\n            month: 'short',\n            day: '2-digit',\n            hour: '2-digit',\n            minute: '2-digit',\n            second: '2-digit',\n            timeZoneName: 'short',\n            hour12: false\n        }).format(this);\n    };\n\n    const originalToLocaleString = Date.prototype.toLocaleString;\n    Date.prototype.toLocaleString = function(locales, options = {}) {\n        return originalToLocaleString.call(this, locales || CONFIG.language, {\n            timeZone: CONFIG.timeZone,\n            ...options\n        });\n    };\n\n    const originalToLocaleDateString = Date.prototype.toLocaleDateString;\n    Date.prototype.toLocaleDateString = function(locales, options = {}) {\n        return originalToLocaleDateString.call(this, locales || CONFIG.language, {\n            timeZone: CONFIG.timeZone,\n            ...options\n        });\n    };\n\n    const originalToLocaleTimeString = Date.prototype.toLocaleTimeString;\n    Date.prototype.toLocaleTimeString = function(locales, options = {}) {\n        return originalToLocaleTimeString.call(this, locales || CONFIG.language, {\n            timeZone: CONFIG.timeZone,\n            ...options\n        });\n    };\n\n    // 6.拦截 WebRTC\n    // 需要清空/拦截的 WebRTC 核心与衍生 API 列表\n    const rtcApis = [\n        'RTCPeerConnection',\n        'webkitRTCPeerConnection',\n        'mozRTCPeerConnection',\n        'RTCSessionDescription',\n        'mozRTCSessionDescription',\n        'RTCIceCandidate',\n        'mozRTCIceCandidate'\n    ];\n\n    // 6.1. 拦截 window 下的 WebRTC 构造函数\n    rtcApis.forEach(api => {\n        if (api in window) {\n            try {\n                // 直接将其设为 undefined，并锁定属性防止网站脚本重新写入\n                Object.defineProperty(window, api, {\n                    value: undefined,\n                    writable: false,\n                    configurable: false,\n                    enumerable: false\n                });\n            } catch (e) {\n                window[api] = undefined;\n            }\n        }\n    });\n\n    // 6.2. 拦截 navigator.mediaDevices 上的媒体流相关方法（可选但推荐）\n    if (navigator.mediaDevices) {\n        const blockMedia = () => Promise.reject(new DOMException('WebRTC/Media disabled by policy', 'NotAllowedError'));\n\n        ['getUserMedia', 'getDisplayMedia'].forEach(method => {\n            if (typeof navigator.mediaDevices[method] === 'function') {\n                try {\n                    Object.defineProperty(navigator.mediaDevices, method, {\n                        value: blockMedia,\n                        writable: false,\n                        configurable: false\n                    });\n                } catch (e) {\n                    navigator.mediaDevices[method] = blockMedia;\n                }\n            }\n        });\n    }\n\n    // 6.3. 拦截旧版 navigator.getUserMedia\n    ['getUserMedia', 'webkitGetUserMedia', 'mozGetUserMedia'].forEach(method => {\n        if (method in navigator) {\n            try {\n                Object.defineProperty(navigator, method, {\n                    value: undefined,\n                    writable: false,\n                    configurable: false\n                });\n            } catch (e) {\n                navigator[method] = undefined;\n            }\n        }\n    });\n\n    // 7. 伪装字体\n    // 允许被网站检测到的基础字体白名单（其余一律伪装为“不存在”）\n    const ALLOWED_FONTS = new Set([\n        'arial',\n        'times new roman',\n        'courier new',\n        'georgia',\n        'helvetica',\n        'sans-serif',\n        'serif',\n        'monospace'\n    ]);\n\n    //  7.1. 拦截 CSS Font Loading API: document.fonts.check()\n    if (document.fonts && document.fonts.check) {\n        const originalCheck = document.fonts.check.bind(document.fonts);\n        document.fonts.check = function(font, text) {\n            // 解析传入的字体字符串，如 \"16px Arial, sans-serif\"\n            const fontNameMatch = font.match(/(?:['\"])(.*?)(?:['\"])|([a-zA-Z\\s-]+)$/);\n            const queriedFont = (fontNameMatch ? (fontNameMatch[1] || fontNameMatch[2]) : font)\n                .trim().toLowerCase();\n\n            if (!ALLOWED_FONTS.has(queriedFont)) {\n                return false; // 不在白名单中的字体均假装未加载\n            }\n            return originalCheck(font, text);\n        };\n    }\n\n    // 7.2. 拦截 Local Font Access API: window.queryLocalFonts\n    if ('queryLocalFonts' in window) {\n        window.queryLocalFonts = async function() {\n            // 伪装为用户拒绝权限，或直接返回空数组\n            throw new DOMException('Permission denied', 'NotAllowedError');\n        };\n    }\n\n    // 7.3. 拦截 Canvas 文本测量 (Canvas measureText)\n    // WIP\n\n})();"}