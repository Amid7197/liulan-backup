 14], 9, -1019803690);\n                c = md5gg(c, d, a, b, x[i + 3], 14, -187363961);\n                b = md5gg(b, c, d, a, x[i + 8], 20, 1163531501);\n                a = md5gg(a, b, c, d, x[i + 13], 5, -1444681467);\n                d = md5gg(d, a, b, c, x[i + 2], 9, -51403784);\n                c = md5gg(c, d, a, b, x[i + 7], 14, 1735328473);\n                b = md5gg(b, c, d, a, x[i + 12], 20, -1926607734);\n                a = md5hh(a, b, c, d, x[i + 5], 4, -378558);\n                d = md5hh(d, a, b, c, x[i + 8], 11, -2022574463);\n                c = md5hh(c, d, a, b, x[i + 11], 16, 1839030562);\n                b = md5hh(b, c, d, a, x[i + 14], 23, -35309556);\n                a = md5hh(a, b, c, d, x[i + 1], 4, -1530992060);\n                d = md5hh(d, a, b, c, x[i + 4], 11, 1272893353);\n                c = md5hh(c, d, a, b, x[i + 7], 16, -155497632);\n                b = md5hh(b, c, d, a, x[i + 10], 23, -1094730640);\n                a = md5hh(a, b, c, d, x[i + 13], 4, 681279174);\n                d = md5hh(d, a, b, c, x[i], 11, -358537222);\n                c = md5hh(c, d, a, b, x[i + 3], 16, -722521979);\n                b = md5hh(b, c, d, a, x[i + 6], 23, 76029189);\n                a = md5hh(a, b, c, d, x[i + 9], 4, -640364487);\n                d = md5hh(d, a, b, c, x[i + 12], 11, -421815835);\n                c = md5hh(c, d, a, b, x[i + 15], 16, 530742520);\n                b = md5hh(b, c, d, a, x[i + 2], 23, -995338651);\n                a = md5ii(a, b, c, d, x[i], 6, -198630844);\n                d = md5ii(d, a, b, c, x[i + 7], 10, 1126891415);\n                c = md5ii(c, d, a, b, x[i + 14], 15, -1416354905);\n                b = md5ii(b, c, d, a, x[i + 5], 21, -57434055);\n                a = md5ii(a, b, c, d, x[i + 12], 6, 1700485571);\n                d = md5ii(d, a, b, c, x[i + 3], 10, -1894986606);\n                c = md5ii(c, d, a, b, x[i + 10], 15, -1051523);\n                b = md5ii(b, c, d, a, x[i + 1], 21, -2054922799);\n                a = md5ii(a, b, c, d, x[i + 8], 6, 1873313359);\n                d = md5ii(d, a, b, c, x[i + 15], 10, -30611744);\n                c = md5ii(c, d, a, b, x[i + 6], 15, -1560198380);\n                b = md5ii(b, c, d, a, x[i + 13], 21, 1309151649);\n                a = md5ii(a, b, c, d, x[i + 4], 6, -145523070);\n                d = md5ii(d, a, b, c, x[i + 11], 10, -1120210379);\n                c = md5ii(c, d, a, b, x[i + 2], 15, 718787259);\n                b = md5ii(b, c, d, a, x[i + 9], 21, -343485551);\n                a = safeAdd(a, olda);\n                b = safeAdd(b, oldb);\n                c = safeAdd(c, oldc);\n                d = safeAdd(d, oldd);\n            }\n            return [a, b, c, d];\n        }\n        function binl2rstr(input) {\n            var output = '';\n            var length32 = input.length * 32;\n            for (var i = 0; i < length32; i += 8) {\n                output += String.fromCharCode((input[i >> 5] >>> (i % 32)) & 0xff);\n            }\n            return output;\n        }\n        function rstr2binl(input) {\n            var output = [];\n            output[(input.length >> 2) - 1] = undefined;\n            for (var i = 0; i < output.length; i += 1) {\n                output[i] = 0;\n            }\n            var length8 = input.length * 8;\n            for (var i = 0; i < length8; i += 8) {\n                output[i >> 5] |= (input.charCodeAt(i / 8) & 0xff) << (i % 32);\n            }\n            return output;\n        }\n        function rstrMD5(s) {\n            return binl2rstr(binlMD5(rstr2binl(s), s.length * 8));\n        }\n        function rstr2hex(input) {\n            var hexTab = '0123456789abcdef';\n            var output = '';\n            var x;\n            for (var i = 0; i < input.length; i += 1) {\n                x = input.charCodeAt(i);\n                output += hexTab.charAt((x >>> 4) & 0x0f) + hexTab.charAt(x & 0x0f);\n            }\n            return output;\n        }\n        return rstr2hex(rstrMD5(str));\n    }\n\n    function genBuvid() {\n        var h = md5Hex(String(Math.random())).toUpperCase();\n        return 'XX' + h[2] + h[12] + h[22] + h;\n    }\n\n    function signQuery(params, secretKey, ts) {\n        params.ts = ts;\n        var keys = Object.keys(params).sort();\n        var query = keys.map(function (k) { return k + '=' + encodeURIComponent(params[k]); }).join('&');\n        return query + '&sign=' + md5Hex(query + secretKey);\n    }\n\n    function gmRequest(opt) {\n        var headers = opt.headers || {};\n        if (opt.method === 'POST' && opt.data) {\n            if (!headers['Content-Type']) {\n                headers['Content-Type'] = 'application/x-www-form-urlencoded; charset=utf-8';\n            }\n        }\n        return new Promise(function (resolve, reject) {\n            GM_xmlhttpRequest({\n                method: opt.method,\n                url: opt.url,\n                data: opt.data,\n                headers: headers,\n                anonymous: !!opt.anonymous,\n                timeout: 15000,\n                onload: function (res) {\n                    try {\n                        resolve({ status: res.status, body: JSON.parse(res.responseText) });\n                    } catch (e) {\n                        reject(new Error('响应不是合法 JSON: ' + res.responseText.slice(0, 200)));\n                    }\n                },\n                onerror: function (res) { reject(new Error('请求失败: ' + res.error)); },\n                ontimeout: function () { reject(new Error('请求超时')); }\n            });\n        });\n    }\n\n    function loginParams(buvid) {\n        return {\n            appkey: LOGIN_APP_KEY,\n            build: BUILD,\n            c_locale: 'zh-Hans_CN',\n            channel: 'website',\n            local_id: buvid,\n            mobi_app: 'android',\n            platform: 'android',\n            s_locale: 'zh-Hans_CN'\n        };\n    }\n\n    function getAuthCode(buvid) {\n        var query = signQuery(loginParams(buvid), LOGIN_APP_SEC, Math.floor(Date.now() / 1000));\n        return gmRequest({\n            method: 'POST',\n            url: PASSPORT + '/x/passport-tv-login/qrcode/auth_code',\n            data: query,\n            headers: { 'User-Agent': DEVICE_UA, 'buvid': buvid },\n            anonymous: true\n        }).then(function (res) {\n            if (res.status !== 200 || res.body.code !== 0) {\n                throw new Error('auth_code 获取失败: ' + JSON.stringify(res.body));\n            }\n            return res.body.data.auth_code;\n        });\n    }\n\n    function qrcodeConfirm(authCode, csrf) {\n        return gmRequest({\n            method: 'POST',\n            url: PASSPORT + '/x/passport-tv-login/h5/qrcode/confirm',\n            data: 'auth_code=' + authCode + '&csrf=' + csrf + '&scanning_type=1',\n            headers: { 'User-Agent': DEVICE_UA }\n        }).then(function (res) {\n            if (res.status !== 200 || res.body.code !== 0) {\n                throw new Error('确认失败: ' + JSON.stringify(res.body));\n            }\n            return res.body.data;\n        });\n    }\n\n    function qrcodePoll(authCode, buvid) {\n        var params = loginParams(buvid);\n        params.auth_code = authCode;\n        var query = signQuery(params, LOGIN_APP_SEC, Math.floor(Date.now() / 1000));\n        return gmRequest({\n            method: 'POST',\n            url: PASSPORT + '/x/passport-tv-login/qrcode/poll',\n            data: query,\n            headers: { 'User-Agent': DEVICE_UA, 'buvid': buvid },\n            anonymous: true\n        }).then(function (res) {\n            if (res.status !== 200 || res.body.code !== 0) {\n                throw new Error('poll 失败: ' + JSON.stringify(res.body));\n            }\n            return res.body.data;\n        });\n    }\n\n    function getCsrf() {\n        var parts = document.cookie.split(';');\n        for (var i = 0; i < parts.length; i++) {\n            var p = parts[i].trim();\n            if (p.indexOf('bili_jct=') === 0) return p.slice(9);\n        }\n        return null;\n    }\n\n    function getStoredKey() {\n        try {\n            return JSON.parse(GM_getValue(AK_STORAGE_KEY, 'null')) || null;\n        } catch (e) {\n            return null;\n        }\n    }\n\n    function saveKey(token) {\n        var expiresAt = Date.now() + (Number(token.expires_in) - 600) * 1000;\n        GM_setValue(AK_STORAGE_KEY, JSON.stringify({\n            access_key: token.access_key,\n            refresh_token: token.refresh_token,\n            mid: token.mid,\n            expires_in: token.expires_in,\n            expires_at: expiresAt,\n            updated_at: new Date().toISOString()\n        }));\n    }\n\n    function isExpired(stored) {\n        return !stored.expires_at || Date.now() >= stored.expires_at;\n    }\n\n    function refreshAccessToken(stored) {\n        var params = {\n            access_token: stored.access_key,\n            refresh_token: stored.refresh_token,\n            appkey: LOGIN_APP_KEY,\n            mobi_app: 'android',\n            platform: 'android',\n            build: BUILD\n        };\n        var query = signQuery(params, LOGIN_APP_SEC, Math.floor(Date.now() / 1000));\n        return gmRequest({\n            method: 'POST',\n            url: PASSPORT + '/x/passport-login/oauth2/refresh_token',\n            data: query,\n            headers: { 'User-Agent': DEVICE_UA }\n        }).then(function (res) {\n            if (res.status !== 200 || res.body.code !== 0) {\n                throw new Error('刷新失败: ' + JSON.stringify(res.body));\n            }\n            var ti = res.body.data.token_info;\n            return {\n                access_key: ti.access_token,\n                refresh_token: ti.refresh_token,\n                mid: ti.mid,\n                expires_in: ti.expires_in\n            };\n        });\n    }\n\n    async function acquireAccessKey() {\n        var csrf = getCsrf();\n        if (!csrf) {\n            throw new Error('未检测到登录态（cookie 中没有 bili_jct），请先登录 B站');\n        }\n        var buvid = genBuvid();\n        var authCode = await getAuthCode(buvid);\n        await qrcodeConfirm(authCode, csrf);\n        var token = await qrcodePoll(authCode, buvid);\n        return {\n            access_key: token.access_token,\n            refresh_token: token.refresh_token,\n            mid: token.mid,\n            expires_in: token.expires_in\n        };\n    }\n\n    async function ensureAccessKey() {\n        var stored = getStoredKey();\n        if (stored && stored.access_key) {\n            if (!isExpired(stored)) {\n                return stored.access_key;\n            }\n            try {\n                var refreshed = await refreshAccessToken(stored);\n                saveKey(refreshed);\n                return refreshed.access_key;\n            } catch (e) {\n            }\n        }\n        console.log('[access_key] 开始获取 access_key ...');\n        var token = await acquireAccessKey();\n        saveKey(token);\n        return token.access_key;\n    }\n\n    async function getSpaceIP(targetUID) {\n        targetUID = String(targetUID).trim();\n        if (!/^[0-9]+$/.test(targetUID)) {\n            throw new Error('UID 必须是纯数字');\n        }\n        var accessKey = await ensureAccessKey();\n        var buvid = genBuvid();\n        var params = {\n            access_key: accessKey,\n            appkey: APP_KEY,\n            build: BUILD,\n            mobi_app: 'android',\n            platform: 'android',\n            vmid: targetUID\n        };\n        var query = signQuery(params, APP_SEC, Math.floor(Date.now() / 1000));\n        var res = await gmRequest({\n            method: 'GET',\n            url: 'https://app.bilibili.com/x/v2/space?' + query,\n            headers: { 'User-Agent': DEVICE_UA, 'buvid': buvid },\n            anonymous: true\n        });\n        if (res.status !== 200 || res.body.code !== 0) {\n            throw new Error('v2/space 请求失败: ' + JSON.stringify(res.body));\n        }\n        var card = res.body.data && res.body.data.card;\n        if (!card) return null;\n        var tags = (card.space_tag || []).concat(card.space_tag_bottom || []);\n        for (var i = 0; i < tags.length; i++) {\n            if (tags[i] && tags[i].type === 'location') {\n                return tags[i].title || null;\n            }\n        }\n        return null;\n    }\n\n    function spaceIP() {\n        const container = document.querySelector('.info-section__content');\n        if (!container) return;\n        const children = container.children;\n        const clone = children[0].cloneNode(true)\n        const i = clone.childNodes[0];\n        const div = clone.childNodes[1];\n        i.className = \"vui-icon\";\n        i.style.color = \"#a2a7ae\";\n        i.style.fontFamily = \"freshspace-zpjpp3aqht\";\n        i.textContent = \"\"\n        div.textContent = \"未知\"\n        getSpaceIP(children[0].children[1].textContent).then((result) => div.textContent = result.slice(5));\n\n        children[0].insertAdjacentElement(\"afterend\",clone)\n    }\n\n    const ipInfoItemObserver = new MutationObserver((mutations) => {\n        for (const mutation of mutations) {\n            if (mutation.type === 'childList') {\n                const container = document.querySelector('.info-section__content');\n                if (container) {\n                    spaceIP();\n                    ipInfoItemObserver.disconnect();\n                    break;\n                }\n            }\n        }\n    });\n\n    commentIP();\n\n    ipInfoItemObserver.observe(document.body, {\n        childList: true,\n        subtree: true\n    });\n    ensureAccessKey().catch(function (e) {\n        console.warn('[access_key] 获取失败：' + e.message);\n    });\n\n})();\n"}