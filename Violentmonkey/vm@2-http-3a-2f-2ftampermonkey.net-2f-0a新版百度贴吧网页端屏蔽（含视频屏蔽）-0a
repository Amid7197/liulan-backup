{"version":2,"custom":{"origInclude":true,"origExclude":true,"origMatch":true,"origExcludeMatch":true,"origTag":true,"lastInstallURL":"https://update.greasyfork.org/scripts/571056/%E6%96%B0%E7%89%88%E7%99%BE%E5%BA%A6%E8%B4%B4%E5%90%A7%E7%BD%91%E9%A1%B5%E7%AB%AF%E5%B1%8F%E8%94%BD%EF%BC%88%E5%90%AB%E8%A7%86%E9%A2%91%E5%B1%8F%E8%94%BD%EF%BC%89.user.js","pathMap":{}},"config":{"enabled":1,"removed":0,"shouldUpdate":1},"props":{"lastUpdated":1774689776975},"code":"// ==UserScript==\n// @name         新版百度贴吧网页端屏蔽（含视频屏蔽）\n// @namespace    http://tampermonkey.net/\n// @version      0.3.1\n// @license      MIT\n// @description  屏蔽指定贴吧、关键词以及视频内容\n// @author       mfcwebfe\n// @match        *://tieba.baidu.com/*\n// @grant        none\n// @downloadURL https://update.greasyfork.org/scripts/571056/%E6%96%B0%E7%89%88%E7%99%BE%E5%BA%A6%E8%B4%B4%E5%90%A7%E7%BD%91%E9%A1%B5%E7%AB%AF%E5%B1%8F%E8%94%BD%EF%BC%88%E5%90%AB%E8%A7%86%E9%A2%91%E5%B1%8F%E8%94%BD%EF%BC%89.user.js\n// @updateURL https://update.greasyfork.org/scripts/571056/%E6%96%B0%E7%89%88%E7%99%BE%E5%BA%A6%E8%B4%B4%E5%90%A7%E7%BD%91%E9%A1%B5%E7%AB%AF%E5%B1%8F%E8%94%BD%EF%BC%88%E5%90%AB%E8%A7%86%E9%A2%91%E5%B1%8F%E8%94%BD%EF%BC%89.meta.js\n// ==/UserScript==\n\n;(function() {\n  'use strict';\n\n  // --- 配置项 ---\n  const blockArr = ['离谱吧', '诛仙世界吧', '印度吧']; // 需完全匹配的贴吧名\n  const keywords = ['孙笑川', '孙吧', '避难所'];\n  const blockVideo = true;\n\n  function clearGarbageTieba() {\n    // 适配新版帖子卡片容器\n    const cards = document.querySelectorAll('.thread-card-wrapper');\n\n    cards.forEach(item => {\n      // 1. 获取贴吧名称\n      const forumElement = item.querySelector('.forum-name');\n      const forumName = forumElement ? forumElement.textContent.trim() : '';\n\n      // 2. 获取帖子标题\n      const titleElement = item.querySelector('.thread-title .text');\n      const postTitle = titleElement ? titleElement.innerText.trim() : '';\n\n      // 3. 检测是否存在视频\n      // 只要卡片内包含 .video-wrapper 或 video 标签即判定为视频贴\n      const hasVideo = blockVideo && (!!item.querySelector('.video-wrapper') || !!item.querySelector('video'));\n\n      // --- 屏蔽逻辑判定 ---\n      const isBlockedForum = blockArr.includes(forumName);\n      const hasKeyword = keywords.some(key => forumName.includes(key) || postTitle.includes(key));\n\n      if (isBlockedForum || hasKeyword || hasVideo) {\n        item.style.display = 'none';\n      }\n    });\n  }\n\n  // 初始化执行\n  clearGarbageTieba();\n\n  // 监听动态加载\n  const observer = new MutationObserver(() => clearGarbageTieba());\n  observer.observe(document.body, { childList: true, subtree: true });\n})();"}