{"version":2,"custom":{"origInclude":true,"origExclude":true,"origMatch":true,"origExcludeMatch":true,"origTag":true,"pathMap":{}},"config":{"enabled":1,"shouldUpdate":1,"httpOnly":0,"removed":0},"props":{"lastUpdated":1794809137290},"code":"// ==UserScript==\n// @name         Claude Spoof (动态配置版)\n// @namespace    https://tampermonkey.net/\n// @version      2.1\n// @description  伪装特定网站的时区、语言和 Intl API 参数 (支持油猴菜单动态切换)\n// @author       You\n// @match        *://*.fuck-claude.com/*\n// @match        *://*.cleanip.io/*\n// @match        *://*.anthropic.com/*\n// @match        *://*.claude.com/*\n// @match        *://*.claude.ai/*\n// @run-at       document-start\n// @grant        GM_registerMenuCommand\n// @grant        GM_setValue\n// @grant        GM_getValue\n// @allFrames    true\n// ==/UserScript==\n\n(function() {\n    'use strict';\n\n    // ==================== 时区地区预设 ====================\n    const REGIONS = {\n        'SG':     { timeZone: 'Asia/Singapore',      locale: 'en-SG' },\n        'JP':     { timeZone: 'Asia/Tokyo',          locale: 'ja-JP' },\n        'US_EST': { timeZone: 'America/New_York',    locale: 'en-US' },\n        'US_PST': { timeZone: 'America/Los_Angeles', locale: 'en-US' },\n        'UK':     { timeZone: 'Europe/London',       locale: 'en-GB' },\n        'AU':     { timeZone: 'Australia/Sydney',    locale: 'en-AU' }\n    };\n\n    // 从油猴存储中读取当前配置的地区，如果没有存过，默认选 'SG'\n    let ACTIVE_REGION = GM_getValue('ACTIVE_REGION', 'SG');\n\n    // 注册油猴菜单命令\n    Object.keys(REGIONS).forEach(regionKey => {\n        GM_registerMenuCommand(`切换到: ${regionKey} (${REGIONS[regionKey].timeZone})`, () => {\n            GM_setValue('ACTIVE_REGION', regionKey);\n            alert(`已切换到 ${regionKey}，点击确定刷新页面即可生效！`);\n            location.reload(); // 刷新页面让新配置生效\n        });\n    });\n\n    const targetRegion = REGIONS[ACTIVE_REGION] || REGIONS['SG'];\n\n    // 动态计算目标时区的当前 offset（完美解决夏令时问题）\n    function getDynamicOffset(timeZone) {\n        const now = new Date();\n        const tzTimeStr = now.toLocaleString('en-US', { timeZone });\n        const tzDate = new Date(tzTimeStr);\n        const utcTimeStr = now.toLocaleString('en-US', { timeZone: 'UTC' });\n        const utcDate = new Date(utcTimeStr);\n        return (utcDate.getTime() - tzDate.getTime()) / 60000;\n    }\n\n    // ==================== 自定义伪装配置 ====================\n    const CONFIG = {\n        language: targetRegion.locale,\n        languages: [targetRegion.locale],\n        timeZone: targetRegion.timeZone,\n        timezoneOffsetMinutes: getDynamicOffset(targetRegion.timeZone)\n    };\n    // =======================================================\n\n    // ...（下面保留你原本的所有逻辑代码：1. 伪装 navigator、2. Intl、3. 其他Intl、4. 伪装Offset、5. 伪装Date格式化、6. 拦截WebRTC、7. 伪装字体）...\n\n    // 1. 伪装 navigator 语言参数\n    const spoofNavigator = (prop, value) => {\n        try {\n            Object.defineProperty(navigator, prop, { get: () => value, configurable: true, enumerable: true });\n        } catch (e) { console.warn(`[Spoofer] Failed to spoof navigator.${prop}`, e); }\n    };\n    spoofNavigator('language', CONFIG.language);\n    spoofNavigator('languages', Object.freeze([...CONFIG.languages]));\n\n    // 2. 伪装 Intl.DateTimeFormat\n    const OriginalDateTimeFormat = Intl.DateTimeFormat;\n    function SpoofedDateTimeFormat(locales, options = {}) {\n        return new OriginalDateTimeFormat(locales || CONFIG.language, { ...options, timeZone: options.timeZone || CONFIG.timeZone });\n    }\n    SpoofedDateTimeFormat.prototype = OriginalDateTimeFormat.prototype;\n    SpoofedDateTimeFormat.supportedLocalesOf = OriginalDateTimeFormat.supportedLocalesOf.bind(OriginalDateTimeFormat);\n\n    const originalResolvedOptions = OriginalDateTimeFormat.prototype.resolvedOptions;\n    OriginalDateTimeFormat.prototype.resolvedOptions = function() {\n        const options = originalResolvedOptions.call(this);\n        options.timeZone = options.timeZone || CONFIG.timeZone;\n        if (!options.locale || options.locale.startsWith('default')) options.locale = CONFIG.language;\n        return options;\n    };\n    window.Intl.DateTimeFormat = SpoofedDateTimeFormat;\n\n    // 3. 拦截其它 Intl 构造函数的默认 locale\n    ['NumberFormat', 'Collator', 'PluralRules', 'RelativeTimeFormat'].forEach(api => {\n        if (Intl[api]) {\n            const OriginalAPI = Intl[api];\n            function SpoofedAPI(locales, options) { return new OriginalAPI(locales || CONFIG.language, options); }\n            SpoofedAPI.prototype = OriginalAPI.prototype;\n            if (OriginalAPI.supportedLocalesOf) SpoofedAPI.supportedLocalesOf = OriginalAPI.supportedLocalesOf.bind(OriginalAPI);\n            window.Intl[api] = SpoofedAPI;\n        }\n    });\n\n    // 4. 伪装 Date.prototype.getTimezoneOffset\n    Date.prototype.getTimezoneOffset = function() { return CONFIG.timezoneOffsetMinutes; };\n\n    // 5. 伪装 Date 格式化输出\n    Date.prototype.toString = function() {\n        return new OriginalDateTimeFormat(CONFIG.language, {\n            timeZone: CONFIG.timeZone, weekday: 'short', year: 'numeric', month: 'short',\n            day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', timeZoneName: 'short', hour12: false\n        }).format(this);\n    };\n    const originalToLocaleString = Date.prototype.toLocaleString;\n    Date.prototype.toLocaleString = function(locales, options = {}) {\n        return originalToLocaleString.call(this, locales || CONFIG.language, { timeZone: CONFIG.timeZone, ...options });\n    };\n    const originalToLocaleDateString = Date.prototype.toLocaleDateString;\n    Date.prototype.toLocaleDateString = function(locales, options = {}) {\n        return originalToLocaleDateString.call(this, locales || CONFIG.language, { timeZone: CONFIG.timeZone, ...options });\n    };\n    const originalToLocaleTimeString = Date.prototype.toLocaleTimeString;\n    Date.prototype.toLocaleTimeString = function(locales, options = {}) {\n        return originalToLocaleTimeString.call(this, locales || CONFIG.language, { timeZone: CONFIG.timeZone, ...options });\n    };\n\n    // 6. 拦截 WebRTC\n    const rtcApis = ['RTCPeerConnection', 'webkitRTCPeerConnection', 'mozRTCPeerConnection', 'RTCSessionDescription', 'mozRTCSessionDescription', 'RTCIceCandidate', 'mozRTCIceCandidate'];\n    rtcApis.forEach(api => {\n        if (api in window) {\n            try { Object.defineProperty(window, api, { value: undefined, writable: false, configurable: false, enumerable: false }); }\n            catch (e) { window[api] = undefined; }\n        }\n    });\n\n    if (navigator.mediaDevices) {\n        const blockMedia = () => Promise.reject(new DOMException('WebRTC/Media disabled by policy', 'NotAllowedError'));\n        ['getUserMedia', 'getDisplayMedia'].forEach(method => {\n            if (typeof navigator.mediaDevices[method] === 'function') {\n                try { Object.defineProperty(navigator.mediaDevices, method, { value: blockMedia, writable: false, configurable: false }); }\n                catch (e) { navigator.mediaDevices[method] = blockMedia; }\n            }\n        });\n    }\n    ['getUserMedia', 'webkitGetUserMedia', 'mozGetUserMedia'].forEach(method => {\n        if (method in navigator) {\n            try { Object.defineProperty(navigator, method, { value: undefined, writable: false, configurable: false }); }\n            catch (e) { navigator[method] = undefined; }\n        }\n    });\n\n    // 7. 伪装字体\n    const ALLOWED_FONTS = new Set(['arial', 'times new roman', 'courier new', 'georgia', 'helvetica', 'sans-serif', 'serif', 'monospace']);\n    if (document.fonts && document.fonts.check) {\n        const originalCheck = document.fonts.check.bind(document.fonts);\n        document.fonts.check = function(font, text) {\n            const fontNameMatch = font.match(/(?:['\"])(.*?)(?:['\"])|([a-zA-Z\\s-]+)$/);\n            const queriedFont = (fontNameMatch ? (fontNameMatch[1] || fontNameMatch[2]) : font).trim().toLowerCase();\n            if (!ALLOWED_FONTS.has(queriedFont)) return false;\n            return originalCheck(font, text);\n        };\n    }\n    if ('queryLocalFonts' in window) {\n        window.queryLocalFonts = async function() { throw new DOMException('Permission denied', 'NotAllowedError'); };\n    }\n\n})();"}