{"version":2,"custom":{"origInclude":true,"origExclude":true,"origMatch":true,"origExcludeMatch":true,"origTag":true,"lastInstallURL":"https://update.greasyfork.org/scripts/575444/%E8%B4%B4%E5%90%A7%E4%B8%80%E9%94%AE%E5%9B%9E%E6%97%A7%E7%89%88.user.js","pathMap":{}},"config":{"enabled":0,"removed":0,"shouldUpdate":1},"props":{"lastUpdated":1784293748680},"code":"// ==UserScript==\n// @name         贴吧一键回旧版\n// @namespace    https://github.com/yourname/tieba-back-to-old\n// @version      1.25\n// @description  自动回旧版\n// @author       a77\n// @license      MIT\n// @match        *://tieba.baidu.com/*\n// @grant        none\n// @run-at       document-start\n// @downloadURL https://update.greasyfork.org/scripts/575444/%E8%B4%B4%E5%90%A7%E4%B8%80%E9%94%AE%E5%9B%9E%E6%97%A7%E7%89%88.user.js\n// @updateURL https://update.greasyfork.org/scripts/575444/%E8%B4%B4%E5%90%A7%E4%B8%80%E9%94%AE%E5%9B%9E%E6%97%A7%E7%89%88.meta.js\n// ==/UserScript==\n\n(function () {\n\n    'use strict';\n\n    let clicked = false;\n\n    function getBtn() {\n        // 更新后的 XPath（div[1] 版本）\n        return document.evaluate(\n            '/html/body/div[1]/div[1]/div/div[2]/div[2]/div[1]',\n            document,\n            null,\n            XPathResult.FIRST_ORDERED_NODE_TYPE,\n            null\n        ).singleNodeValue;\n    }\n\n    function doClick(btn) {\n\n        if (!btn) return false;\n\n        console.log('[贴吧回旧版] 尝试点击');\n\n        // 连续强点\n        for (let i = 0; i < 3; i++) {\n\n            btn.click();\n\n            btn.dispatchEvent(new MouseEvent('click', {\n                bubbles: true,\n                cancelable: true,\n                view: window\n            }));\n\n            btn.dispatchEvent(new PointerEvent('pointerdown', {\n                bubbles: true\n            }));\n\n            btn.dispatchEvent(new PointerEvent('pointerup', {\n                bubbles: true\n            }));\n        }\n\n        clicked = true;\n\n        console.log('[贴吧回旧版] ✅ 已点击');\n\n        return true;\n    }\n\n    // 核心：长时间持续检测\n    const timer = setInterval(() => {\n\n        if (clicked) {\n\n            clearInterval(timer);\n\n            return;\n        }\n\n        const btn = getBtn();\n\n        if (btn) {\n\n            doClick(btn);\n\n        }\n\n    }, 300);\n\n    // 30秒保险\n    setTimeout(() => {\n\n        clearInterval(timer);\n\n    }, 30000);\n\n})();"}