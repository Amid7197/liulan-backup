{"version":2,"custom":{"origInclude":true,"origExclude":true,"origMatch":true,"origExcludeMatch":true,"origTag":true,"lastInstallURL":"https://update.greasyfork.org/scripts/570477/%E3%80%90%E4%BC%98%E5%8C%96%E7%89%88%E3%80%91%E7%9F%A5%E4%B9%8E%E6%98%BE%E7%A4%BAIP%E5%B1%9E%E5%9C%B0.user.js","pathMap":{}},"config":{"enabled":1,"removed":0,"shouldUpdate":1},"props":{"lastUpdated":1776933768551},"code":"// ==UserScript==\n// @name         【优化版】知乎显示IP属地\n// @namespace    http://tampermonkey.net/\n// @version      0.1\n// @description  在知乎回答中显示作者IP属地\n// @author       You\n// @match        https://www.zhihu.com/*\n// @grant        GM_xmlhttpRequest\n// @license      MIT\n// @downloadURL https://update.greasyfork.org/scripts/570477/%E3%80%90%E4%BC%98%E5%8C%96%E7%89%88%E3%80%91%E7%9F%A5%E4%B9%8E%E6%98%BE%E7%A4%BAIP%E5%B1%9E%E5%9C%B0.user.js\n// @updateURL https://update.greasyfork.org/scripts/570477/%E3%80%90%E4%BC%98%E5%8C%96%E7%89%88%E3%80%91%E7%9F%A5%E4%B9%8E%E6%98%BE%E7%A4%BAIP%E5%B1%9E%E5%9C%B0.meta.js\n// ==/UserScript==\n\n(function() {\n    'use strict';\n\n    // 添加CSS样式\n    const style = document.createElement('style');\n    style.textContent = `\n        .ip-location {\n            font-size: 14px;\n            color: #8590a6;\n            margin-left: 4px;\n            display: inline-block;\n            line-height: 1.5;\n        }\n        .ip-location::before {\n            content: \"·\";\n            margin-right: 4px;\n            color: #8590a6;\n        }\n    `;\n    document.head.appendChild(style);\n\n    // 提取IP属地文本\n    function extractIPLocation(ipElement) {\n        if(!ipElement) return null;\n        \n        // 获取完整文本\n        let fullText = ipElement.textContent.trim();\n        \n        // 匹配 \"IP 属地湖南\" 或 \"IP属地湖南\" 格式\n        const match = fullText.match(/IP\\s*属地\\s*(\\S+)/);\n        if(match) {\n            return match[1]; // 只返回属地名称，如\"湖南\"\n        }\n        \n        // 如果上面没匹配到，尝试直接提取属地名称\n        const locationMatch = fullText.match(/属地\\s*(\\S+)/);\n        if(locationMatch) {\n            return locationMatch[1];\n        }\n        \n        return null;\n    }\n\n    // 获取作者主页链接并添加IP属地信息\n    function addIPLocation() {\n        const authorLinks = document.querySelectorAll('.UserLink-link');\n\n        authorLinks.forEach(link => {\n            if(link.dataset.processed) return;\n            link.dataset.processed = true;\n\n            const authorUrl = link.href;\n            // 查找内容项容器\n            const contentItem = link.closest('.ContentItem');\n            if(!contentItem) return;\n\n            // 查找发布时间元素\n            const timeElement = contentItem.querySelector('.ContentItem-time');\n            if(!timeElement) return;\n            \n            // 避免重复添加\n            if(timeElement.querySelector('.ip-location')) return;\n\n            // 创建IP属地显示元素\n            const ipSpan = document.createElement('span');\n            ipSpan.className = 'ip-location';\n            ipSpan.textContent = '加载中';\n            \n            // 将IP信息插入到时间元素内部\n            timeElement.appendChild(ipSpan);\n\n            GM_xmlhttpRequest({\n                method: 'GET',\n                url: authorUrl,\n                onload: function(response) {\n                    const parser = new DOMParser();\n                    const doc = parser.parseFromString(response.responseText, 'text/html');\n\n                    // 查找IP属地元素\n                    const ipElement = doc.querySelector('.css-1xfvezd');\n                    const locationName = extractIPLocation(ipElement);\n                    \n                    if(locationName) {\n                        ipSpan.textContent = locationName;\n                    } else {\n                        ipSpan.remove(); // 如果获取不到，移除元素\n                    }\n                },\n                onerror: function() {\n                    ipSpan.remove();\n                }\n            });\n        });\n    }\n\n    // 监听页面变化\n    const observer = new MutationObserver(addIPLocation);\n    observer.observe(document.body, {\n        childList: true,\n        subtree: true\n    });\n\n    // 初始执行\n    addIPLocation();\n})();"}